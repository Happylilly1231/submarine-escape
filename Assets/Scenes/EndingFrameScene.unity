  m_EditorClassIdentifier: 
  endingFrames:
  - type: 0
    displayImage: {fileID: 1757837777}
    lockedSprite: {fileID: 21300000, guid: 87b9f9c3c00c0ae44a4fcc45c179b9e5, type: 3}
    unlockedSprite: {fileID: 21300000, guid: 77ed958cd7360914892f7c89fca0ef2b, type: 3}
    clickButton: {fileID: 1787993382}
    endingFrame: {fileID: 1617689568}
    endingTitle: "\uC775\uC219\uD55C \uC545\uBABD\uC758 \uC7AC\uD68C"
    endingDescription: "\uADF8\uAC83\uC740 \uD55C\uB54C \uB3D9\uB8CC\uC600\uB358
      '\uBB34\uC5B8\uAC00'\uC600\uB2E4. \r\n\uB4F1 \uB4A4\uB85C \uB3CB\uC544\uB09C
      \uAC70\uBBF8 \uAC19\uC740 \uB2E4\uB9AC\uB4E4\uC774 \uAE08\uC18D \uBCF5\uB3C4\uB97C
      \uAE01\uC73C\uBA70 \uAE30\uAD34\uD55C \uC18D\uB3C4\uB85C \uB2E4\uAC00\uC628\uB2E4.
      \r\n.....\uB108\uC758 \uB9C8\uC9C0\uB9C9 \uBE44\uBA85\uC740 \uCC22\uACA8\uB098\uAC04
      \uC721\uC2E0 \uC0AC\uC774\uB85C \uD769\uC5B4\uC84C\uB2E4."
    isUnlocked: 0
    currentPlayerTime: 0
    bestClearTime: 0
    beatPlayerName: 
  - type: 1
    displayImage: {fileID: 460666352}
    lockedSprite: {fileID: 21300000, guid: 87b9f9c3c00c0ae44a4fcc45c179b9e5, type: 3}
    unlockedSprite: {fileID: 21300000, guid: 8254cb624fdd16c41a7d3df03359d346, type: 3}
    clickButton: {fileID: 1775404828}
    endingFrame: {fileID: 1622334174}
    endingTitle: "\uC2EC\uD574\uC758 \uB9C8\uCE68\uD45C"
    endingDescription: "\uAC70\uB300\uD55C \uC218\uC555\uACFC \uD568\uAED8 \uC7A0\uC218\uD568\uC774
      \uC694\uB3D9\uCCE4\uB2E4.\r\n\uC774\uC5B4\uC9C4 \uD3ED\uBC1C\uC74C\r\n\uC2EC\uD574\uC758
      \uAD34\uBB3C\uC740 \uACB0\uAD6D \uB108\uB97C \uCC3E\uC544\uB0C8\uB2E4.\r\n.....\uADF8\uB9AC\uACE0
      \uC544\uBB34\uAC83\uB3C4 \uB0A8\uC9C0 \uC54A\uC558\uB2E4."
    isUnlocked: 0
    currentPlayerTime: 0
    bestClearTime: 0
    beatPlayerName: 
  - type: 2
    displayImage: {fileID: 1060667532}
    lockedSprite: {fileID: 21300000, guid: 87b9f9c3c00c0ae44a4fcc45c179b9e5, type: 3}
    unlockedSprite: {fileID: 21300000, guid: 7652033f955147348bd16eef6a680708, type: 3}
    clickButton: {fileID: 1350851126}
    endingFrame: {fileID: 1912869519}
    endingTitle: "\uAC00\uC7A5 \uB0AE\uC740 \uACF3\uC73C\uB85C"
    endingDescription: "\uC911\uB825\uC740 \uB108\uB97C \uB354 \uAE4A\uC740 \uC2EC\uC5F0\uC73C\uB85C
      \uB04C\uC5B4\uB0B4\uB838\uB2E4. \r\n\uC9E7\uC740 \uBE44\uBA85 \uB05D\uC5D0
      \uB4E4\uB824\uC628 \uAC83\uC740 \uB454\uD0C1\uD55C \uD30C\uC5F4\uC74C\uBFD0.
      \r\n.....\uCC28\uB514\uCC2C \uC7A0\uC218\uD568\uC758 \uBC14\uB2E5\uC774 \uB108\uC758
      \uB9C8\uC9C0\uB9C9 \uCE68\uC0C1\uC774 \uB418\uC5C8\uB2E4."
    isUnlocked: 0
    currentPlayerTime: 0
    bestClearTime: 0
    beatPlayerName: 
  - type: 3
    displayImage: {fileID: 1716876420}
    lockedSprite: {fileID: 21300000, guid: 87b9f9c3c00c0ae44a4fcc45c179b9e5, type: 3}
    unlockedSprite: {fileID: 21300000, guid: ed3288e1af6c47643958456bd790bfed, type: 3}
    clickButton: {fileID: 1015708479}
    endingFrame: {fileID: 1413086875}
    endingTitle: "\uC624\uB9CC\uD55C \uD655\uC2E0\uC758 \uB300\uAC00"
    endingDescription: "\uACA8\uC6B0 \uC774\uB7F0 \uAC04\uB2E8\uD55C \uD37C\uC990\uC870\uCC28
      \uB9DE\uCD94\uC9C0 \uBABB\uD560 \uC904\uC774\uC57C. \r\n\uAD34\uBB3C\uC5D0\uAC8C
      \uBA39\uD788\uAE30\uB3C4 \uC804\uC5D0 \uC2A4\uC2A4\uB85C \uC790\uBA78\uD558\uB2E4\uB2C8\n\uC774\uBCF4\uB2E4
      \uC6B0\uC2A4\uAF5D\uC2A4\uB7EC\uC6B4 \uCD5C\uD6C4\uAC00 \uC788\uC744\uAE4C?
      \r\n.....\uC8FD\uC74C\uC870\uCC28 \uB108\uC758 \uBA4D\uCCAD\uD568\uC744 \uAC00\uB824\uC8FC\uC9C0\uB294
      \uBABB\uD588\uB2E4."
    isUnlocked: 0
    currentPlayerTime: 0
    bestClearTime: 0
    beatPlayerName: 
  - type: 4
    displayImage: {fileID: 1641701513}
    lockedSprite: {fileID: 21300000, guid: 87b9f9c3c00c0ae44a4fcc45c179b9e5, type: 3}
    unlockedSprite: {fileID: 21300000, guid: 11d4e7c76a7c3d74ab56bf362e7ed24e, type: 3}
    clickButton: {fileID: 1043105077}
    endingFrame: {fileID: 71311143}
    endingTitle: "\uC545\uBABD\uC758 \uB300\uBB3C\uB9BC"
    endingDescription: "\uB1CC\uAC00 \uB179\uC544\uB0B4\uB9B4 \uB4EF\uD55C \uACE0\uC5F4\uC774
      \uC628\uBAB8\uC744 \uC9C0\uBC30\uD588\uB2E4.\n\uB4F1 \uB4A4\uC758 \uC0B4\uAC17\uC744
      \uB6AB\uACE0 \uC870\uAE08\uC529 \uB3CB\uC544\uB098\uB358 \uAC00\uC2DC\uB4E4\uC740,
      \uACB0\uAD6D \uBF08\uB97C \uAE4E\uB294 \uACE0\uD1B5\uACFC \uD568\uAED8 \uC644\uC804\uD788
      \uC790\uB77C\uB098 \uAC70\uB300\uD55C \uD749\uAE30\uAC00 \uB418\uC5C8\uB2E4.\n\uC778\uAC04\uC758
      \uC721\uC2E0\uC774 \uBB34\uB108\uC9C4 \uC790\uB9AC\uC5D0 \uB9C8\uCE68\uB0B4
      \uC644\uBCBD\uD55C \uAD34\uBB3C\uC774 \uC6B0\uB69D \uC120\uB2E4.\n\uC778\uAC04\uC774\uC5C8\uB358
      '\uB108'\uC758 \uC774\uC131\uC740 \uCC28\uAC00\uC6B4 \uC2EC\uD574 \uC18D\uC73C\uB85C
      \uC601\uC6D0\uD788 \uC0AC\uBA78\uD588\uB2E4.\n.....\uC774\uC81C\uB294 \uB124\uAC00,
      \uB204\uAD70\uAC00\uC758 \uC775\uC219\uD55C \uC545\uBABD\uC774 \uB420 \uCC28\uB840\uB2E4."
    isUnlocked: 0
    currentPlayerTime: 0
    bestClearTime: 0
    beatPlayerName: 
  - type: 5
    displayImage: {fileID: 321167151}
    lockedSprite: {fileID: 21300000, guid: 87b9f9c3c00c0ae44a4fcc45c179b9e5, type: 3}
    unlockedSprite: {fileID: 21300000, guid: 8965bcc44193beb45bdd5d068c13a202, type: 3}
    clickButton: {fileID: 1604367391}
    endingFrame: {fileID: 259706893}
    endingTitle: "\uB354 \uD070 \uC2EC\uC5F0\uC758 \uB208\uB3D9\uC790"
    endingDescription: "\uAC00\uAE4C\uC2A4\uB85C \uD0C8\uCD9C\uC2E4\uC5D0 \uB3C4\uCC29\uD588\uB2E4.
      \r\n\uB108\uB294 \uC774\uC81C\uC57C \uC548\uB3C4\uC758 \uC228\uC744 \uB0B4\uBC49\uB294\uB2E4.
      \r\n\uD558\uC9C0\uB9CC \uADF8\uAC83\uB3C4 \uC7A0\uC2DC, \uC7A0\uC218\uD568
      \uBC16\uC740 \uAC70\uB300\uD55C '\uBB34\uC5B8\uAC00'\uAC00 \uB2E4\uAC00\uC624\uACE0
      \uC788\uB2E4.\r\n....\uACFC\uC5F0 \uB108\uB294 \uC9C4\uC815\uD55C '\uD0C8\uCD9C'\uC5D0
      \uB2E4\uB2E4\uB790\uB294\uAC00?"
