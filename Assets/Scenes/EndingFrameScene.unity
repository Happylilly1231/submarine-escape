    clickButton: {fileID: 1043105077}
    endingDescription: "\uAC00\uAE4C\uC2A4\uB85C \uD0C8\uCD9C\uC2E4\uC5D0 \uB3C4\uCC29\uD588\uB2E4.
      \r\n\uB108\uB294 \uC774\uC81C\uC57C \uC548\uB3C4\uC758 \uC228\uC744 \uB0B4\uBC49\uB294\uB2E4.
      \r\n\uD558\uC9C0\uB9CC \uADF8\uAC83\uB3C4 \uC7A0\uC2DC, \uC7A0\uC218\uD568
      \uBC16\uC740 \uAC70\uB300\uD55C '\uBB34\uC5B8\uAC00'\uAC00 \uB2E4\uAC00\uC624\uACE0
      \uC788\uB2E4.\r\n....\uACFC\uC5F0 \uB108\uB294 \uC9C4\uC815\uD55C '\uD0C8\uCD9C'\uC5D0
