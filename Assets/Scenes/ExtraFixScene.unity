PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 1761410121}
    m_Modifications:
    - target: {fileID: 269696380741257492, guid: f11efe1587a95c841bd6ef73e716bce9,
        type: 3}
      propertyPath: m_text
      value: "[ \uBD84\uC11D \uBCF4\uACE0\uC11C: #04-SC \uBE44\uB298 \uACB0\uC815\uD654
        ]"
      objectReference: {fileID: 0}
    - target: {fileID: 576309490558802962, guid: f11efe1587a95c841bd6ef73e716bce9,
        type: 3}
      propertyPath: m_AnchorMax.x
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 576309490558802962, guid: f11efe1587a95c841bd6ef73e716bce9,
        type: 3}
      propertyPath: m_AnchorMax.y
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 2622348755917626613, guid: f11efe1587a95c841bd6ef73e716bce9,
        type: 3}
      propertyPath: m_AnchoredPosition.y
      value: 0.00021043309
      objectReference: {fileID: 0}
    - target: {fileID: 3381649187523871055, guid: f11efe1587a95c841bd6ef73e716bce9,
        type: 3}
      propertyPath: m_Size
      value: 0.9999974
      objectReference: {fileID: 0}
    - target: {fileID: 3663646327868264946, guid: f11efe1587a95c841bd6ef73e716bce9,
        type: 3}
      propertyPath: m_HorizontalScrollbar
      value: 
      objectReference: {fileID: 0}
    - target: {fileID: 6237837915454140890, guid: f11efe1587a95c841bd6ef73e716bce9,
        type: 3}
      propertyPath: m_text
      value: "<b>\uAC1C\uC694:</b> \uD06C\uB9AC\uC2A4\uD0C8 \uC2A4\uCF00\uC77C \uB4DC\uB798\uACE4
        \uD53C\uC2DC \uC678\uD53C \uC0D8\uD50C\uC758 \uC5F4\uC5ED\uD559\uC801 \uBC18\uC751
        \uBD84\uC11D\r\n\r\n<size=110%><b>[ \uAD00\uCC30 \uB370\uC774\uD130 ]</b></size>\r\n\uBCF8
        \uAC1C\uCCB4\uC758 \uBE44\uB298\uC740 \uC2EC\uD574\uC758 \uADF9\uC800\uC628
        \uD658\uACBD\uC5D0\uC11C \uC644\uBCBD\uD55C \uACB0\uC815 \uAD6C\uC870\uB97C
        \uC720\uC9C0\uD558\uBA70 \r\n\uC678\uBD80 \uC555\uB825\uC73C\uB85C\uBD80\uD130
        \uC2E0\uCCB4\uB97C \uBCF4\uD638\uD55C\uB2E4.\r\n\r\n\uADF8\uB7EC\uB098 \uC678\uBD80\uC5D0\uC11C
        <b>\uAC15\uB825\uD55C \uC5F4 \uC5D0\uB108\uC9C0</b>\uAC00 \uAC00\uD574\uC9C8
        \uACBD\uC6B0, \r\n\uACB0\uC815 \uB0B4\uBD80\uC758 \uBBF8\uB124\uB784 \uACB0\uD569\uC774
        \uBD95\uAD34\uB418\uBA70 \uD45C\uBA74 \uC131\uBD84\uC774 \r\n<b>'\uC7AC\uACB0\uC815\uD654(Recrystallization)'</b>\uB418\uC5B4
        \uBD84\uB9AC\uB418\uB294 \uD2B9\uC774 \uD604\uC0C1\uC774 \uD655\uC778\uB418\uC5C8\uB2E4.\r\n\r\n<size=110%><b>[
        \uC57D\uB9AC\uC801 \uD6A8\uB2A5 ]</b></size>\r\n\uC774\uB807\uAC8C \uCD94\uCD9C\uB41C
        \uACB0\uC815\uCCB4\uB294 H2-S1 \uBCF5\uD569\uCCB4 \uBC30\uD569 \uACFC\uC815\uC5D0\uC11C
        \r\n\uD544\uC218\uC801\uC778 <b>'\uC911\uD654\uC81C'</b> \uC5ED\uD560\uC744
        \uC218\uD589\uD55C\uB2E4.\r\n\r\n\uD2B9\uD788 \uD22C\uC5EC \uC2DC \uBC1C\uC0DD\uD558\uB294
        \uCE58\uBA85\uC801\uC778 \uC2E0\uACBD\uACC4 \uAC70\uBD80 \uBC18\uC751\r\n(\uADF9\uB3C4\uC758
        \uC2E0\uACBD \uACFC\uBBFC \uBC0F \uD658\uAC01 \uC99D\uC138)\uC744 \uC989\uAC01\uC801\uC73C\uB85C
        \uC5B5\uC81C\uD558\uBA70, \r\n\uC219\uC8FC\uC758 \uC2E0\uACBD\uB9DD\uC744
        \uC548\uC815\uD654\uD558\uB294 \uB370 \uD0C1\uC6D4\uD55C \uD6A8\uB2A5\uC744
        \uBCF4\uC778\uB2E4.\r\n\r\n<size=110%><b>[ \uC8FC\uC758 \uC0AC\uD56D ]</b></size>\r\n\uBBF8\uB124\uB784
        \uBD84\uB9AC\uB97C \uC704\uD55C \uC5D0\uB108\uC9C0 \uC8FC\uC785 \uC2DC, \uC784\uACC4
        \uC628\uB3C4\uB97C \uCD08\uACFC\uD560 \uACBD\uC6B0 \r\n\uC131\uBD84\uC774
        \uBCC0\uC131\uB418\uC5B4 \uC99D\uBC1C\uD560 \uC704\uD5D8\uC774 \uC788\uB2E4.\r\n\r\n\uAC00\uC5F4
        \uC7A5\uBE44\uAC00 \uBD80\uC7AC\uD55C \uBE44\uC0C1 \uC0C1\uD669\uC5D0\uC11C\uB294
        \r\n<b>\uACE0\uC18D \uD68C\uC804 \uAE30\uAD6C\uC758 \uB9C8\uCC30\uC5F4</b>\uC744
        \uC774\uC6A9\uD55C \uB300\uCCB4 \uCD94\uCD9C \uBC29\uC2DD\uC744 \uAD8C\uC7A5\uD55C\uB2E4."
      objectReference: {fileID: 0}
