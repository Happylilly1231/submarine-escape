    - target: {fileID: 6237837915454140890, guid: f11efe1587a95c841bd6ef73e716bce9,
        type: 3}
      propertyPath: m_text
      value: "\uCD94\uCD9C\uB41C <b>H1 \uC778\uC790</b>\uB294 \uB2E8\uB3C5 \uC0AC\uC6A9
        \uC2DC \uC0DD\uCCB4 \uB0B4 \uB18D\uCD95 \uC18D\uB3C4\uAC00 \uB290\uB824 \uD6A8\uC728\uC774
        \uB0AE\uC73C\uB098, \n\uC544\uBE44\uC124 \uBA74\uC5ED\uBB38\uC5B4\uC758 <b>\uB18D\uCD95
        \uC810\uC561</b>\uACFC \uC801\uC815 \uBE44\uC728\uB85C \uBC30\uD569\uB420
        \uB54C \n\uBE44\uB85C\uC18C <b>X1 \uC778\uC790\uC758 \uD65C\uC131 \uAE30\uC804\uC744
        \uC644\uC804\uD788 \uC5B5\uC81C</b>\uD568.\n\n\uBCF8 \uD654\uD569\uBB3C\uC740
        \uAC1C\uCCB4\uC758 \uBE44\uC815\uC0C1\uC801\uC778 \uBE5B \uBBFC\uAC10\uC131\uC744
        \uBB34\uB825\uD654\uD558\uB294 \uD575\uC2EC \uC131\uBD84\uC73C\uB85C \uD310\uB2E8\uB428.\n\n<color=red>\uB2E8,
        \uBC30\uD569 \uACFC\uC815\uC5D0\uC11C \uBD88\uC21C\uBB3C\uC774 \uC11E\uC77C
        \uACBD\uC6B0 \uBC1C\uAD11 \uB2E8\uBC31\uC9C8\uC758 \uBCC0\uC131\uC774 \uC77C\uC5B4\uB0A0
        \uC218 \uC788\uC73C\uBBC0\uB85C \uC8FC\uC758\uB97C \uC694\uD568.</color>"
      objectReference: {fileID: 0}
