  reportId: OpticalStimulusResponse
  title: "#02 \uAD11\uD559 \uC790\uADF9 \uBC18\uC751"
  content: "\n<b>\uAC1C\uC694</b>\n\uBCC0\uC774 \uC2E4\uD5D8\uCCB4\uC758 \uD2B9\uC815
    \uD30C\uC7A5 \uAD11\uC6D0 \uB178\uCD9C \uC2DC \uBC1C\uC0DD\uD558\uB294 \uC0DD\uCCB4
    \uBC18\uC751 \uBC0F \uC870\uC9C1 \uBCC0\uD654 \uBD84\uC11D.\n\n<b>[ \uC2E4\uD5D8
    \uB300\uC0C1 ]</b>\n\uC0AC\uC6A9 \uC7A5\uBE44: \uACE0\uCD9C\uB825 \uAD11\uC790
    \uC870\uC0AC\uAE30\n\uBD84\uC11D \uC778\uC790: <b>X1 \uC778\uC790</b>\n\n<b>[
    \uAD00\uCC30 \uB370\uC774\uD130 ]</b>\n\uB300\uC0C1\uCCB4\uB294 \uD2B9\uC815
    \uD30C\uC7A5\uC758 \uBE5B\uC5D0 \uB178\uCD9C\uB420 \uACBD\uC6B0 \uC989\uAC01\uC801\uC778
    \uD68C\uD53C \uBC18\uC751\uC744 \uBCF4\uC600\uB2E4.\n\uCD08\uAE30 \uB2E8\uACC4\uC5D0\uC11C\uB294
    \uB2E8\uC21C \uACBD\uB828 \uC218\uC900\uC774\uC5C8\uC73C\uB098, \uB178\uCD9C
    \uC2DC\uAC04\uC774 \uC99D\uAC00\uD560\uC218\uB85D \uC678\uACE8\uACA9 \uD45C\uBA74
    \uADE0\uC5F4 \uBC0F \uC870\uC9C1 \uBD95\uAD34 \uD604\uC0C1\uC774 \uBC1C\uC0DD\uD55C\uB2E4.\n\uB300\uC0C1\uCCB4\uC758
    \uB4F1 \uBD80\uC704 \uC678\uACE8\uACA9\uC774 \uBE44\uC815\uC0C1\uC801\uC73C\uB85C
    \uAC08\uB77C\uC9C0\uBA70 \uB0B4\uBD80 \uC870\uC9C1\uC774 \uB3CC\uCD9C\uB418\uAE30
    \uC2DC\uC791\uD558\uC600\uB2E4.\n\uC774\uD6C4 <color=#FF4444><b>\uCC99\uCD94
    \uC591\uCE21\uC5D0\uC11C \uC0C8\uB85C\uC6B4 \uAD00\uC808 \uAD6C\uC870\uAC00 \uD615\uC131</b></color>\uB418\uC5C8\uC73C\uBA70,
    \uC0C8\uB86D\uAC8C \uD615\uC131\uB41C \uC870\uC9C1\uC740 \uAE30\uC874 \uACE8\uACA9\uACFC
    \uB3C5\uB9BD\uC801\uC73C\uB85C \uC6C0\uC9C1\uC600\uB2E4.\n\n<b>[ \uBD84\uC11D
    \uACB0\uACFC ]</b>\n<color=#FF4444><b>\uCCB4\uB0B4 \uC794\uB958 \uC911\uC778
    X1 \uC778\uC790\uAC00 \uC678\uBD80 \uAD11\uC790 \uC790\uADF9\uACFC \uBC18\uC751\uD558\uC5EC
    \uC2E0\uACBD\uACC4\uB97C \uACFC\uC790\uADF9\uD558\uB294 \uAC83\uC73C\uB85C \uD310\uB2E8\uB41C\uB2E4.</b></color>\n\uAC15\uD55C
    \uAD11 \uC790\uADF9 \uD658\uACBD\uC5D0\uC11C\uB294 \uC138\uD3EC \uBCC0\uC774
    \uC18D\uB3C4\uAC00 \uAE09\uACA9\uD788 \uC99D\uAC00\uD558\uBA70, \uC5B5\uC81C\uB418\uC5B4
    \uC788\uB358 \uC870\uC9C1 \uC7AC\uAD6C\uC131\uC774 \uD3ED\uBC1C\uC801\uC73C\uB85C
    \uC9C4\uD589\uB418\uB294 \uD604\uC0C1\uC774 \uD655\uC778\uB418\uC5C8\uB2E4.\n\n"
