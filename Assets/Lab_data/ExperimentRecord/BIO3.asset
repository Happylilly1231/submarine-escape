  reportId: CrystallizationReactionAnalysis
  title: "#03-SC \uACB0\uC815\uD654 \uBC18\uC751 \uBD84\uC11D"
  content: "\n<b>\uAC1C\uC694\r</b>\r\n\uD06C\uB9AC\uC2A4\uD0C8 \uC2A4\uCF00\uC77C
    \uB4DC\uB798\uACE4 \uD53C\uC2DC(Crystal-Scale Dragonfish)\uC758 \uC678\uD53C
    \uC870\uC9C1 \uBC0F \uACB0\uC815\uD654 \uBE44\uB298 \uC0D8\uD50C\uC5D0 \uB300\uD55C
    \uC5F4\uC5ED\uD559 \uBC18\uC751 \uBD84\uC11D.\r\n\r\n<b>[ \uC2E4\uD5D8 \uB300\uC0C1
    ]</b>\r\n\uAC1C\uCCB4 \uCF54\uB4DC: SC-DFS-03\r\r\n\uCD94\uCD9C \uBD80\uC704:
    \uACB0\uC815\uD654 \uBE44\uB298\r\n\uC8FC\uC694 \uC131\uBD84: <color=#FFCC00><b>\uC800\uC628
    \uC801\uC751\uD615 \uBBF8\uB124\uB784 \uBCF5\uD569\uCCB4\r</b>\r</color>\n\r\n<b>[
    \uAD00\uCC30 \uB370\uC774\uD130 ]</b>\r\n\uBCF8 \uAC1C\uCCB4\uC758 \uC678\uD53C
    \uBE44\uB298\uC740 \uC2EC\uD574 5,000m \uC774\uD558\uC758 \uADF9\uC800\uC628\xB7\uACE0\uC555
    \uD658\uACBD\uC5D0\uC11C\uB3C4 \uC548\uC815\uC801\uC778 \uACB0\uC815 \uACA9\uC790
    \uAD6C\uC870\uB97C \uC720\uC9C0\uD558\uB294 \uD2B9\uC131\uC774 \uD655\uC778\uB418\uC5C8\uB2E4.\r\n\uACB0\uC815\uCE35\uC740
    \uC678\uBD80 \uC555\uB825\uC744 \uBD84\uC0B0\uC2DC\uD0A4\uB294 \uB3D9\uC2DC\uC5D0
    \uC138\uD3EC\uB9C9 \uC190\uC0C1\uC744 \uC5B5\uC81C\uD558\uBA70, \uAE09\uACA9\uD55C
    \uC628\uB3C4 \uBCC0\uD654 \uD658\uACBD\uC5D0\uC11C\uB3C4 \uC870\uC9C1 \uC548\uC815\uC131\uC744
    \uC720\uC9C0\uD55C\uB2E4.\r\n\uADF8\uB7EC\uB098 \uC678\uBD80\uC5D0\uC11C \uC77C\uC815
    \uC218\uC900 \uC774\uC0C1\uC758 \uC5F4 \uC5D0\uB108\uC9C0\uAC00 \uAC00\uD574\uC9C8
    \uACBD\uC6B0, \uACB0\uC815 \uB0B4\uBD80 \uBBF8\uB124\uB784 \uACB0\uD569\uC774
    \uBD95\uAD34\uB418\uBA70 \uD45C\uBA74 \uAD6C\uC870\uAC00 <color=#FFCC00><b>\uC7AC\uACB0\uC815\uD654</b>\r</color>\n\uB418\uB294
    \uD604\uC0C1\uC774 \uBC1C\uC0DD\uD558\uC600\uB2E4.\r\n\uC774 \uACFC\uC815\uC5D0\uC11C
    \uACE0\uB18D\uCD95 \uAD11\uBB3C\uC131 \uC794\uC5EC\uBB3C\uC774 \uACB0\uC815\uCE35\uC73C\uB85C\uBD80\uD130
    \uBD84\uB9AC\uB41C\uB2E4.\n\r\n<b>[ \uBD84\uC11D \uACB0\uACFC ]</b>\r\n\uBD84\uB9AC\uB41C
    \uACB0\uC815 \uC131\uBD84\uC740 \uAC15\uB825\uD55C \uBC18\uC751 \uC548\uC815\uD654
    \uD2B9\uC131\uC744 \uBCF4\uC600\uC73C\uBA70, \n<color=#FFCC00><b>H2-S1 \uBCF5\uD569\uCCB4
    \uBC30\uD569 \uACFC\uC815\uC5D0\uC11C \uC911\uD654\uC81C\uB85C \uC791\uC6A9\uD558\uB294
    \uAC83\uC774 \uD655\uC778\uB418\uC5C8\uB2E4.\r</b>\r</color>\n\uD22C\uC5EC \uC774\uD6C4
    \uB2E4\uC74C \uC99D\uC0C1\uC774 \uC77C\uC2DC\uC801\uC73C\uB85C \uC644\uD654\uB428:\r\n\u25CF
    \uC2E0\uACBD \uACFC\uBBFC \uBC18\uC751\r\n\u25CF \uD658\uAC01 \uC99D\uC138\r\n\u25CF
    \uCCAD\uAC01 \uD3ED\uC8FC\r\n\u25CF \uC138\uD3EC \uD65C\uC131 \uBD88\uADE0\uD615\r\n\uD2B9\uD788
    \uBCF5\uD569\uCCB4 \uD22C\uC5EC \uC9C1\uD6C4 \uBC1C\uC0DD\uD558\uB358 \uAE09\uC131
    \uC2E0\uACBD\uACC4 \uAC70\uBD80 \uBC18\uC751\uC774 \uD604\uC800\uD788 \uAC10\uC18C\uD558\uC600\uC73C\uBA70,
    \uC2E4\uD5D8\uCCB4\uC758 \uC2E0\uACBD \uD30C\uD615 \uB610\uD55C \uC548\uC815
    \uC218\uCE58\uC5D0 \uADFC\uC811\uD55C\uB2E4.\n\r\n<b>[ \uC704\uD5D8 \uC694\uC18C
    \uBC0F \uC8FC\uC758 \uC0AC\uD56D ]</b>\r\n<color=#FF4444><b>\uACB0\uC815 \uBD84\uB9AC
    \uACFC\uC815 \uC911 \uC784\uACC4 \uC628\uB3C4\uB97C \uCD08\uACFC\uD560 \uACBD\uC6B0,</b>\r</color>\n\uC131\uBD84\uC774
    \uAE09\uACA9\uD788 \uBCC0\uC131\uB418\uBA70 \uC99D\uBC1C\uD558\uB294 \uD604\uC0C1\uC774
    \uD655\uC778\uB418\uC5C8\uB2E4.\r\n\uBCC0\uC131 \uC774\uD6C4 \uC0DD\uC131\uB41C
    \uBD80\uC0B0\uBB3C\uC740 <color=#FF4444><b>\uAC15\uD55C \uC2E0\uACBD \uC790\uADF9\uC131</b>\r</color>                                          
    \uC744 \uB760\uBA70, \uB2E4\uC74C \uC99D\uC0C1\uC774 \uBCF4\uACE0\uB428\r:\n\u25CF
    \uADFC\uC721 \uC870\uC9C1 \uACFC\uC99D\uC2DD\n\u25CF \uD658\uCCAD\r\n\u25CF \uC2DC\uC57C
    \uC65C\uACE1\r\r\n<color=#00FFFF><b>\uAC00\uC5F4 \uC7A5\uBE44\uAC00 \uBD80\uC7AC\uD55C
    \uC0C1\uD669\uC5D0\uC11C\uB294 \uACE0\uC18D \uD68C\uC804 \uC7A5\uCE58\uC758 \uB9C8\uCC30\uC5F4\uC744
    \uC774\uC6A9\uD55C \uB300\uCCB4 \uCD94\uCD9C \uBC29\uC2DD\uC774 \uAD8C\uC7A5\uB41C\uB2E4.\r</b>\r</color>\n\uB2E8,
    \uCD94\uCD9C \uC2E4\uD328 \uC2DC \uACB0\uC815\uCE35 \uBD95\uAD34\uC640 \uD568\uAED8
    \uACE0\uC628 \uD30C\uD3B8\uC774 \uBC29\uCD9C\uB420 \uC704\uD5D8\uC774 \uC788\uC74C.\n\n"
