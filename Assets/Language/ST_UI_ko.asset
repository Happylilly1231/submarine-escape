  - m_Id: 543263415525382
    m_Localized: "\uB300\uC0AC \uCD09\uC9C4 \uD608\uC561"
    m_Metadata:
      m_Items: []
  - m_Id: 543263415525383
    m_Localized: "\uB300\uC0AC \uC5B5\uC81C \uD608\uCCAD"
    m_Metadata:
      m_Items: []
  - m_Id: 543263415525384
    m_Localized: "\uBCC0\uD615 \uBC1C\uD1B1"
    m_Metadata:
      m_Items: []
  - m_Id: 543263415525385
    m_Localized: "\uBCC0\uC774 \uC810\uC561"
    m_Metadata:
      m_Items: []
  - m_Id: 543263415525386
    m_Localized: "\uC801\uC751 \uBE44\uB298 \uC870\uAC01"
    m_Metadata:
      m_Items: []
  - m_Id: 543263415525387
    m_Localized: "\uC7AC\uC0DD \uACE8\uC218"
    m_Metadata:
      m_Items: []
  - m_Id: 543263415525388
    m_Localized: "\uAC15\uD654 \uB4F1\uAECD\uC9C8"
    m_Metadata:
      m_Items: []
  - m_Id: 543263415525389
    m_Localized: "\uCD94\uCD9C \uD608\uC561"
    m_Metadata:
      m_Items: []
  - m_Id: 543263415525390
    m_Localized: "\uAC00\uC2A4 \uC8FC\uBA38\uB2C8"
    m_Metadata:
      m_Items: []
  - m_Id: 544373287084032
    m_Localized: "\uBCF5\uD569 \uC5B5\uC81C \uD608\uCCAD"
    m_Metadata:
      m_Items: []
  - m_Id: 901934343446528
    m_Localized: "\uAD34\uBB3C \uCC99\uC218\uC5D0 \uAF42\uC544 \uCD94\uCD9C"
    m_Metadata:
      m_Items: []
  - m_Id: 752864434348032
    m_Localized: "\uBE45\uD130\uC758 \uB2E4\uC774\uC5B4\uB9AC"
    m_Metadata:
      m_Items: []
  - m_Id: 754063640387584
    m_Localized: "\uD575\uC2EC \uAD8C\uD55C\uAD8C\uC790 \uBA85\uB2E8"
    m_Metadata:
      m_Items: []
  - m_Id: 754063640387585
    m_Localized: "\uC2E4\uD5D8\uCCB4 \uC778\uC801\uC0AC\uD56D \uAE30\uB85D\uBD80"
    m_Metadata:
      m_Items: []
  - m_Id: 1078952628510720
    m_Localized: "*\uC8FC\uC758*\n\n\uD0C8\uCD9C \uC2DC\uC5D0\uB9CC \n\uAC1C\uBC29\uD558\uC2DC\uC624.\n(\uACBD\uBCF4
      \uBC1C\uC0DD \uC8FC\uC758)"
    m_Metadata:
      m_Items: []
  - m_Id: 1440805049262080
    m_Localized: "\u25CF \uC131\uBD84: \uCD08\uACE0\uAC15\uB3C4 \uD0A4\uD2F4 \uBCC0\uD615\uCCB4\n\u25CF
      \uD6A8\uB2A5: \uADFC\uC721 \uC12C\uC720 \uBC00\uB3C4 \uAC15\uD654."
    m_Metadata:
      m_Items: []
  - m_Id: 1440805166702592
    m_Localized: "\u25CF \uC131\uBD84: \uB300\uC0AC \uCD09\uC9C4 \uD6A8\uC18C\n\u25CF
      \uD6A8\uB2A5: \uC138\uD3EC \uC5D0\uB108\uC9C0 \uC0DD\uC131 \uAC00\uC18D. <b>\uACFC\uB3C4
      \uC0AC\uC6A9 \uC2DC \uC2E0\uCCB4 \uACFC\uBD80\uD558 \uC720\uBC1C.</b>"
    m_Metadata:
      m_Items: []
  - m_Id: 1440805166702593
    m_Localized: "\u25CF \uC131\uBD84: \uC555\uB825 \uC801\uC751 \uBBF8\uB124\uB784,
      S1 \uC778\uC790\n\u25CF \uD6A8\uB2A5: <b>\uC870\uC9C1 \uAC04 \uACB0\uD569\uB825\uC744
      \uB192\uC5EC</b> \uC2E0\uCCB4 \uAD6C\uC870\uB97C \uACE0\uC815\uD558\uB294 \uD6A8\uACFC\uAC00
      \uC788\uC74C."
    m_Metadata:
      m_Items: []
  - m_Id: 1440805166702594
    m_Localized: "\u25CF \uC131\uBD84: \uC800\uC628 \uC801\uC751\uD615 \uC5B5\uC81C
      \uC778\uC790\n\u25CF \uD6A8\uB2A5: <b>\uD654\uD559\uC801 \uBC18\uC751 \uC18D\uB3C4
      \uC81C\uC5B4 \uBC0F \uC548\uC815\uD654.</b>"
    m_Metadata:
      m_Items: []
  - m_Id: 1440805166702595
    m_Localized: "\u25CF \uC131\uBD84: \uACA9\uC790 \uAD6C\uC870\uC758 \uC800\uC628
      \uC801\uC751\uD615 \uBBF8\uB124\uB784 \uBCF5\uD569\uCCB4\r\n\u25CF \uD6A8\uB2A5:
      \uC678\uBD80 \uACE8\uACA9\uC5D0 \uB192\uC740 \uC720\uC5F0\uC131\uACFC \uADF9\uC800\uC628
      \uB0B4\uC131\uC744 \uB3D9\uC2DC\uC5D0 \uBD80\uC5EC\uD568. <b>\uAE09\uACA9\uD55C
      \uC628\uB3C4 \uBCC0\uD654 \uBC0F \uACE0\uC555 \uD658\uACBD\uC5D0\uC11C \uC138\uD3EC\uB9C9\uC774
      \uD30C\uAD34\uB418\uB294 \uAC83\uC744 \uBC29\uC9C0\uD568.</b>"
    m_Metadata:
      m_Items: []
  - m_Id: 1440805166702596
    m_Localized: "\u25CF \uC131\uBD84: \uACE0\uACBD\uB3C4 \uC0DD\uCCB4 \uC138\uB77C\uBBF9
      \uBCC0\uD615\uCCB4\r\n\u25CF \uD6A8\uB2A5: \uC870\uC9C1 \uAC15\uD654 \uC57D\uBB3C\uC758
      \uC548\uC815\uC131 \uC2E4\uD5D8 \uBC0F \uACBD\uD654\uC81C \uC6D0\uB8CC."
    m_Metadata:
      m_Items: []
  - m_Id: 1440805166702597
    m_Localized: "\u25CF \uC131\uBD84: \uC138\uD3EC \uBCC0\uC774 \uCD09\uC9C4 \uD6A8\uC18C\r\n\u25CF
      \uD6A8\uB2A5: \uBE44\uC815\uC0C1\uC801 \uC138\uD3EC \uC131\uC7A5 \uBC0F \uD615\uD0DC
      \uBCC0\uC774 \uC720\uB3C4."
    m_Metadata:
      m_Items: []
  - m_Id: 1440805166702598
    m_Localized: "\u25CF \uC131\uBD84: H2 \uC778\uC790\r\n\u25CF \uD6A8\uB2A5: \uC138\uD3EC
      \uB0B4 \uD2B9\uC815 \uC2E0\uD638 \uC804\uB2EC \uACBD\uB85C\uB97C \uCC28\uB2E8\uD558\uC5EC
      <b>\uBE44\uC815\uC0C1\uC801\uC778 \uB300\uC0AC \uC18D\uB3C4\uB97C \uAC15\uC81C\uB85C
      \uB2A6\uCDA4.</b>"
    m_Metadata:
      m_Items: []
  - m_Id: 1440805166702599
    m_Localized: "\u25CF \uC131\uBD84: \uACE0\uD718\uBC1C\uC131 \uD655\uC0B0 \uB9E4\uAC1C\uCCB4\n\u25CF
      \uD6A8\uB2A5: \uC561\uCCB4 \uC0C1\uD0DC\uC758 \uD654\uD569\uBB3C\uC744 \uACF5\uAE30
      \uC911\uC73C\uB85C \uC989\uC2DC \uAE30\uD654 \uBC0F \uD655\uC0B0\uC2DC\uD0A4\uB294
      \uB9E4\uAC1C\uCCB4 \uC5ED\uD560.\n\u25CF <mark=#FF000044>\uBE44\uACE0: [\uC704\uD5D8]</mark>
      \uC8FC\uBA38\uB2C8 \uD30C\uC5F4 \uC2DC \uB0B4\uC6A9\uBB3C\uC774 \uC989\uAC01
      \uAC00\uC2A4\uD654\uB418\uC5B4 \uBC18\uACBD 5m \uC774\uB0B4\uB85C \uD655\uC0B0\uB428.
      \uD2B9\uC218 \uC131\uBD84\uC758 \uAD11\uBC94\uC704 \uC0B4\uD3EC \uC2DC \uD544\uC218
      \uC7AC\uB8CC\uB85C \uD65C\uC6A9\uB428."
    m_Metadata:
      m_Items: []
  - m_Id: 1440805166702600
    m_Localized: "\u25CF \uC131\uBD84: \uC790\uAC00 \uC7AC\uC0DD \uC720\uB3C4 \uD608\uCCAD\r\n\u25CF
      \uD6A8\uB2A5: <b>\uC138\uD3EC \uB2E8\uC704 \uBCF5\uAD6C \uAC00\uC18D\uD654.</b>"
    m_Metadata:
      m_Items: []
  - m_Id: 1440805166702601
    m_Localized: "\u25CF \uC131\uBD84: \uBA74\uC5ED \uC138\uD3EC \uC99D\uD3ED \uD6A8\uC18C\r\n\u25CF
      \uD6A8\uB2A5: \uC0DD\uCCB4 \uBA74\uC5ED \uBC18\uC751\uC758 \uBE44\uC57D\uC801
      \uD65C\uC131\uD654."
    m_Metadata:
      m_Items: []
  - m_Id: 1440805166702602
    m_Localized: "\u25CF \uC131\uBD84: \uACE0\uB18D\uCD95 \uBA74\uC5ED\uCD09\uC9C4
      \uB2E8\uBC31\uC9C8 H1 \uC778\uC790\n\u25CF \uD6A8\uB2A5: <b>\uAC15\uD55C \uBE5B\xB7\uBC29\uC0AC\uC120\uC5D0
      \uB300\uD55C \uB0B4\uC131 \uBD80\uC5EC.</b>"
    m_Metadata:
      m_Items: []
  - m_Id: 1440805166702603
    m_Localized: "\u25CF \uC131\uBD84: \uC870\uD608\xB7\uC870\uACE8 \uC720\uB3C4
      \uC138\uD3EC\r\n\u25CF \uD6A8\uB2A5: \uACE8\uC218 \uB0B4 \uC870\uACE8 \uC138\uD3EC
      \uC720\uB3C4 \uBC0F <b>\uACE8\uACA9 \uC7AC\uC0DD \uCD09\uC9C4.</b>"
    m_Metadata:
      m_Items: []
  - m_Id: 1440805166702604
    m_Localized: "\u25CF \uC131\uBD84: \uBA74\uC5ED \uC548\uC815 \uC778\uC790\r\n\u25CF
      \uD6A8\uB2A5: \uACFC\uD65C\uC131 \uBA74\uC5ED \uBC18\uC751 \uC644\uD654. (\uBB38\uC5B4
      \uC131\uBD84\uACFC \uD63C\uD569 \uC2DC <b>\uC0DD\uCCB4 \uADE0\uD615 \uC720\uC9C0</b>)"
    m_Metadata:
      m_Items: []
  - m_Id: 1440805166702605
    m_Localized: "\u25CF \uC131\uBD84: \uCE7C\uC298-\uC555\uB825 \uC801\uC751 \uB2E8\uBC31\uC9C8\r\n\u25CF
      \uD6A8\uB2A5: \uBF08 \uBC00\uB3C4 \uBC0F \uC678\uBD80 \uACE8\uACA9 \uAC15\uB3C4
      \uAC15\uD654."
    m_Metadata:
      m_Items: []
  - m_Id: 1440805166702606
    m_Localized: "\n<b>\uAC1C\uC694</b>\n\uC544\uBE44\uC124 \uBA74\uC5ED\uBB38\uC5B4(Abyssal
      Immune Octopus)\uC758 \uBC1C\uAD11\uCCB4 \uC870\uC9C1\uC5D0\uC11C \uCD94\uCD9C\uD55C
      \uBA74\uC5ED\uCD09\uC9C4 \uB2E8\uBC31\uC9C8\uC758 \uC0DD\uCCB4 \uBC18\uC751
      \uBD84\uC11D.\n\n<b>[ \uC2E4\uD5D8 \uB300\uC0C1 ]</b>\n\uAC1C\uCCB4 \uCF54\uB4DC:
      AI-OCT-04\n\uCD94\uCD9C \uBD80\uC704: \uBC1C\uAD11\uCCB4\n\uCD94\uCD9C \uC131\uBD84:
      <color=#FFCC00><b>H1 \uC778\uC790</b></color>\n\n<b>[ \uAD00\uCC30 \uB370\uC774\uD130
      ]</b>\nH1 \uC778\uC790\uB294 \uADF9\uB3C4\uB85C \uB192\uC740 \uC0DD\uCCB4 \uD65C\uC131
      \uBC18\uC751\uC744 \uBCF4\uC774\uBA70, \uAD11\uC790 \uC790\uADF9 \uD658\uACBD\uC5D0\uC11C
      \uAC1C\uCCB4\uC758 \uC870\uC9C1 \uC548\uC815\uC131\uC744 \uC720\uC9C0\uC2DC\uD0A4\uB294
      \uD2B9\uC131\uC774 \uD655\uC778\uB41C\uB2E4.\n\uC2E4\uD5D8\uCCB4 \uD22C\uC5EC
      \uACB0\uACFC, \uAC15\uD55C \uC870\uBA85 \uBC0F \uBC29\uC0AC\uC120 \uB178\uCD9C
      \uC0C1\uD669\uC5D0\uC11C\uB3C4 \uC2E0\uACBD\uACC4 \uACFC\uBBFC \uBC18\uC751\uC774
      \uD604\uC800\uD788 \uAC10\uC18C\uD558\uC600\uB2E4.\n\uD2B9\uD788 <color=#FFCC00><b>X1
      \uC778\uC790</b></color>\uC5D0 \uC758\uD574 \uBC1C\uC0DD\uD558\uB358 \uBE44\uC815\uC0C1\uC801
      \uAD11 \uBBFC\uAC10 \uBC18\uC751\uC774 \uB300\uBD80\uBD84 \uC18C\uC2E4\uB418\uC5C8\uB2E4.\n\n<b>[
      \uBD84\uC11D \uACB0\uACFC ]</b>\n<color=#FFCC00><b>H1 \uC778\uC790\uB294 X1
      \uC778\uC790\uC758 \uD65C\uC131 \uAE30\uC804\uC744 \uC9C1\uC811\uC801\uC73C\uB85C
      \uC5B5\uC81C\uD558\uB294 \uAC83\uC73C\uB85C \uD310\uB2E8\uB41C\uB2E4.</b></color>\n\uD22C\uC5EC
      \uC774\uD6C4 \uB2E4\uC74C \uC99D\uC0C1\uC774 \uC548\uC815\uD654\uB428:\n\u25CF
      \uADFC\uC721 \uC870\uC9C1 \uACFC\uC99D\uC2DD\n\u25CF \uAD11\uC6D0 \uD68C\uD53C
      \uBC18\uC751\n\u25CF \uC2DC\uC2E0\uACBD \uC790\uADF9 \uD3ED\uC8FC\n\uBCF8 \uC131\uBD84\uC740
      \uD604\uC7AC\uAE4C\uC9C0 \uD655\uC778\uB41C X1 \uC5B5\uC81C \uBB3C\uC9C8 \uC911
      \uAC00\uC7A5 \uB192\uC740 \uC548\uC815\uC131\uC744 \uBCF4\uC778\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1440805166702607
    m_Localized: "#01-AI \uBA74\uC5ED \uBC18\uC751 \uBD84\uC11D"
    m_Metadata:
      m_Items: []
  - m_Id: 1440805166702608
    m_Localized: "#02-BL \uB300\uC0AC \uC5B5\uC81C \uBC18\uC751 \uBD84\uC11D"
    m_Metadata:
      m_Items: []
  - m_Id: 1440805166702609
    m_Localized: "\n<b>\uAC1C\uC694</b>\n\uBE14\uB799\uB9AC\uBC84 \uB9AC\uCE58(Black-River
      Leech)\uC758 \uCCB4\uB0B4 \uCD94\uCD9C \uC131\uBD84\uC778 H2 \uC778\uC790\uC758
      \uC0DD\uCCB4 \uB300\uC0AC \uC5B5\uC81C \uD2B9\uC131 \uBC0F X2 \uC778\uC790
      \uBC18\uC751\uC131 \uBD84\uC11D.\n\n<b>[ \uC2E4\uD5D8 \uB300\uC0C1 ]</b>\n\uAC1C\uCCB4
      \uCF54\uB4DC: BR-LCH-02\n\uCD94\uCD9C \uBD80\uC704: \uB300\uC0AC \uC5B5\uC81C
      \uD608\uCCAD\n\uCD94\uCD9C \uC131\uBD84: <color=#FFCC00><b>H2 \uC778\uC790</b></color>\n\n<b>[
      \uAD00\uCC30 \uB370\uC774\uD130 ]</b>\nH2 \uC778\uC790\uB294 \uCCB4\uB0B4 \uD2B9\uC815
      \uC2E0\uD638 \uC804\uB2EC \uACBD\uB85C\uB97C \uAC15\uC81C\uB85C \uCC28\uB2E8\uD558\uC5EC
      \uBE44\uC815\uC0C1\uC801\uC778 \uC138\uD3EC \uD65C\uC131 \uC18D\uB3C4\uB97C
      \uAC10\uC18C\uC2DC\uD0A4\uB294 \uD2B9\uC131\uC744 \uBCF4\uC600\uB2E4.\n\uB2E8\uB3C5
      \uD22C\uC5EC \uC2E4\uD5D8\uC5D0\uC11C\uB294 X2 \uC778\uC790 \uD65C\uC131 \uC5B5\uC81C
      \uD6A8\uACFC\uAC00 \uBD88\uC644\uC804\uD558\uC600\uC73C\uBA70, \uB300\uC0C1\uCCB4\uC758
      \uACF5\uACA9\uC131 \uBC0F \uC870\uC9C1 \uBCC0\uC774 \uC18D\uB3C4 \uB610\uD55C
      \uC720\uC758\uBBF8\uD558\uAC8C \uAC10\uC18C\uD558\uC9C0 \uC54A\uC558\uB2E4.\n\uADF8\uB7EC\uB098
      \uC2EC\uC5F0 \uD3EC\uC2DD\uAC8C(Abyssal Predator Crab)\uC758 \uCCB4\uB0B4 \uCD94\uCD9C
      \uC131\uBD84\uC778 <color=#FFCC00><b>S1 \uC778\uC790</b></color>\uC640 \uACB0\uD569\uD558\uC5EC
      \uBCF5\uD569\uCCB4\uB97C \uD615\uC131\uD560 \uACBD\uC6B0, <color=#FFCC00><b>X2
      \uC778\uC790</b></color>\uC758 \uD65C\uC131 \uBC18\uC751\uC774 \uAE09\uACA9\uD788
      \uAC10\uC18C\uD558\uB294 \uD604\uC0C1\uC774 \uD655\uC778\uB418\uC5C8\uB2E4.\n\n<b>[
      \uBD84\uC11D \uACB0\uACFC ]</b>\n<color=#FFCC00><b>H2-S1 \uBCF5\uD569\uCCB4
      \uD22C\uC5EC</b></color> \uC774\uD6C4 \uB2E4\uC74C \uC99D\uC0C1\uC774 \uC548\uC815\uD654\uB428:\n\u25CF
      \uACF5\uACA9 \uCDA9\uB3D9 \uC99D\uAC00\n\u25CF \uCCAD\uAC01 \uACFC\uBBFC \uBC18\uC751\n\u25CF
      \uC2E0\uACBD\uACC4 \uD3ED\uC8FC \uD604\uC0C1\n\uD604\uC7AC\uAE4C\uC9C0 \uD655\uC778\uB41C
      \uBB3C\uC9C8 \uC911 <b>X2 \uC778\uC790</b> \uC5B5\uC81C \uD6A8\uC728\uC774
      \uAC00\uC7A5 \uB192\uC558\uB2E4.\n\n<b>[ \uBD80\uC791\uC6A9 \uBC0F \uD2B9\uC774
      \uC0AC\uD56D ]</b>\n\uBCF5\uD569\uCCB4 \uD22C\uC5EC \uC774\uD6C4 \uC2E4\uD5D8\uCCB4\uC5D0\uAC8C\uC11C
      \uC2EC\uAC01\uD55C \uC815\uC2E0 \uC774\uC0C1 \uC99D\uC0C1\uC774 \uBCF4\uACE0\uB418\uC5C8\uB2E4.\n\uC8FC\uC694
      \uC0AC\uB840:\n\u25CF <color=#FF4444><b>\uD658\uAC01</b></color>\n\u25CF <color=#FF4444><b>\uADF9\uB2E8\uC801
      \uACF5\uACA9\uC131 \uC99D\uAC00</b></color>\n\uC77C\uBD80 \uC2E4\uD5D8\uCCB4\uB294
      \uACA9\uB9AC\uBCBD\uC744 \uC9C0\uC18D\uC801\uC73C\uB85C \uD0C0\uACA9\uD558\uB294
      \uD589\uB3D9\uC744 \uBCF4\uC778\uB2E4.\n\uBD80\uC791\uC6A9 \uBC1C\uC0DD \uC6D0\uC778\uC740
      \uD604\uC7AC \uC870\uC0AC \uC911\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1440805166702610
    m_Localized: "#03-SC \uACB0\uC815\uD654 \uBC18\uC751 \uBD84\uC11D"
    m_Metadata:
      m_Items: []
  - m_Id: 1440805183479808
    m_Localized: "\n<b>\uAC1C\uC694</b>\n\uD06C\uB9AC\uC2A4\uD0C8 \uC2A4\uCF00\uC77C
      \uB4DC\uB798\uACE4 \uD53C\uC2DC(Crystal-Scale Dragonfish)\uC758 \uC678\uD53C
      \uC870\uC9C1 \uBC0F \uACB0\uC815\uD654 \uBE44\uB298 \uC0D8\uD50C\uC5D0 \uB300\uD55C
      \uC5F4\uC5ED\uD559 \uBC18\uC751 \uBD84\uC11D.\n\n<b>[ \uC2E4\uD5D8 \uB300\uC0C1
      ]</b>\n\uAC1C\uCCB4 \uCF54\uB4DC: SC-DFS-03\n\uCD94\uCD9C \uBD80\uC704: \uACB0\uC815\uD654
      \uBE44\uB298\n\uC8FC\uC694 \uC131\uBD84: <color=#FFCC00><b>\uC800\uC628 \uC801\uC751\uD615
      \uBBF8\uB124\uB784 \uBCF5\uD569\uCCB4</b></color>\n\n<b>[ \uAD00\uCC30 \uB370\uC774\uD130
      ]</b>\n\uBCF8 \uAC1C\uCCB4\uC758 \uC678\uD53C \uBE44\uB298\uC740 \uC2EC\uD574
      5,000m \uC774\uD558\uC758 \uADF9\uC800\uC628\xB7\uACE0\uC555 \uD658\uACBD\uC5D0\uC11C\uB3C4
      \uC548\uC815\uC801\uC778 \uACB0\uC815 \uACA9\uC790 \uAD6C\uC870\uB97C \uC720\uC9C0\uD558\uB294
      \uD2B9\uC131\uC774 \uD655\uC778\uB418\uC5C8\uB2E4.\n\uACB0\uC815\uCE35\uC740
      \uC678\uBD80 \uC555\uB825\uC744 \uBD84\uC0B0\uC2DC\uD0A4\uB294 \uB3D9\uC2DC\uC5D0
      \uC138\uD3EC\uB9C9 \uC190\uC0C1\uC744 \uC5B5\uC81C\uD558\uBA70, \uAE09\uACA9\uD55C
      \uC628\uB3C4 \uBCC0\uD654 \uD658\uACBD\uC5D0\uC11C\uB3C4 \uC870\uC9C1 \uC548\uC815\uC131\uC744
      \uC720\uC9C0\uD55C\uB2E4.\n\uADF8\uB7EC\uB098 \uC678\uBD80\uC5D0\uC11C \uC77C\uC815
      \uC218\uC900 \uC774\uC0C1\uC758 \uC5F4 \uC5D0\uB108\uC9C0\uAC00 \uAC00\uD574\uC9C8
      \uACBD\uC6B0, \uACB0\uC815 \uB0B4\uBD80 \uBBF8\uB124\uB784 \uACB0\uD569\uC774
      \uBD95\uAD34\uB418\uBA70 \uD45C\uBA74 \uAD6C\uC870\uAC00 <color=#FFCC00><b>\uC7AC\uACB0\uC815\uD654</b></color>\n\uB418\uB294
      \uD604\uC0C1\uC774 \uBC1C\uC0DD\uD558\uC600\uB2E4.\n\uC774 \uACFC\uC815\uC5D0\uC11C
      \uACE0\uB18D\uCD95 \uAD11\uBB3C\uC131 \uC794\uC5EC\uBB3C\uC774 \uACB0\uC815\uCE35\uC73C\uB85C\uBD80\uD130
      \uBD84\uB9AC\uB41C\uB2E4.\n\n<b>[ \uBD84\uC11D \uACB0\uACFC ]</b>\n\uBD84\uB9AC\uB41C
      \uACB0\uC815 \uC131\uBD84\uC740 \uAC15\uB825\uD55C \uBC18\uC751 \uC548\uC815\uD654
      \uD2B9\uC131\uC744 \uBCF4\uC600\uC73C\uBA70, \n<color=#FFCC00><b>H2-S1 \uBCF5\uD569\uCCB4
      \uBC30\uD569 \uACFC\uC815\uC5D0\uC11C \uC911\uD654\uC81C\uB85C \uC791\uC6A9\uD558\uB294
      \uAC83\uC774 \uD655\uC778\uB418\uC5C8\uB2E4.</b></color>\n\uD22C\uC5EC \uC774\uD6C4
      \uB2E4\uC74C \uC99D\uC0C1\uC774 \uC77C\uC2DC\uC801\uC73C\uB85C \uC644\uD654\uB428:\n\u25CF
      \uC2E0\uACBD \uACFC\uBBFC \uBC18\uC751\n\u25CF \uD658\uAC01 \uC99D\uC138\n\u25CF
      \uCCAD\uAC01 \uD3ED\uC8FC\n\u25CF \uC138\uD3EC \uD65C\uC131 \uBD88\uADE0\uD615\n\uD2B9\uD788
      \uBCF5\uD569\uCCB4 \uD22C\uC5EC \uC9C1\uD6C4 \uBC1C\uC0DD\uD558\uB358 \uAE09\uC131
      \uC2E0\uACBD\uACC4 \uAC70\uBD80 \uBC18\uC751\uC774 \uD604\uC800\uD788 \uAC10\uC18C\uD558\uC600\uC73C\uBA70,
      \uC2E4\uD5D8\uCCB4\uC758 \uC2E0\uACBD \uD30C\uD615 \uB610\uD55C \uC548\uC815
      \uC218\uCE58\uC5D0 \uADFC\uC811\uD55C\uB2E4.\n\n<b>[ \uC704\uD5D8 \uC694\uC18C
      \uBC0F \uC8FC\uC758 \uC0AC\uD56D ]</b>\n<color=#FF4444><b>\uACB0\uC815 \uBD84\uB9AC
      \uACFC\uC815 \uC911 \uC784\uACC4 \uC628\uB3C4\uB97C \uCD08\uACFC\uD560 \uACBD\uC6B0,</b></color>\n\uC131\uBD84\uC774
      \uAE09\uACA9\uD788 \uBCC0\uC131\uB418\uBA70 \uC99D\uBC1C\uD558\uB294 \uD604\uC0C1\uC774
      \uD655\uC778\uB418\uC5C8\uB2E4.\n\uBCC0\uC131 \uC774\uD6C4 \uC0DD\uC131\uB41C
      \uBD80\uC0B0\uBB3C\uC740 <color=#FF4444><b>\uAC15\uD55C \uC2E0\uACBD \uC790\uADF9\uC131</b></color>                                          
      \uC744 \uB760\uBA70, \uB2E4\uC74C \uC99D\uC0C1\uC774 \uBCF4\uACE0\uB428:\n\u25CF
      \uADFC\uC721 \uC870\uC9C1 \uACFC\uC99D\uC2DD\n\u25CF \uD658\uCCAD\n\u25CF \uC2DC\uC57C
      \uC65C\uACE1\n<color=#00FFFF><b>\uAC00\uC5F4 \uC7A5\uBE44\uAC00 \uBD80\uC7AC\uD55C
      \uC0C1\uD669\uC5D0\uC11C\uB294 \uACE0\uC18D \uD68C\uC804 \uC7A5\uCE58\uC758
      \uB9C8\uCC30\uC5F4\uC744 \uC774\uC6A9\uD55C \uB300\uCCB4 \uCD94\uCD9C \uBC29\uC2DD\uC774
      \uAD8C\uC7A5\uB41C\uB2E4.</b></color>\n\uB2E8, \uCD94\uCD9C \uC2E4\uD328 \uC2DC
      \uACB0\uC815\uCE35 \uBD95\uAD34\uC640 \uD568\uAED8 \uACE0\uC628 \uD30C\uD3B8\uC774
      \uBC29\uCD9C\uB420 \uC704\uD5D8\uC774 \uC788\uC74C."
    m_Metadata:
      m_Items: []
  - m_Id: 1440805183479809
    m_Localized: "#09-CH \uCD5C\uC885 \uACB0\uD569 \uAD6C\uC870 \uBC0F \uBC18\uC751
      \uAC80\uC0AC"
    m_Metadata:
      m_Items: []
  - m_Id: 1440805183479810
    m_Localized: "\n<b>[ \uD604\uBBF8\uACBD \uAD00\uCC30 \uB370\uC774\uD130 ]</b>\n\uC815\uC0C1\uC801\uC73C\uB85C
      \uC870\uD569\uB41C \uC0D8\uD50C\uC744 \uD604\uBBF8\uACBD\uC73C\uB85C \uAD00\uCC30\uD55C
      \uACBD\uC6B0, <color=#FFCC00><b>\uC120\uBA85\uD55C \uCCAD\uC0C9 \uACB0\uC815\uCCB4\uAC00
      \uC721\uAC01\uD615 \uC0AC\uC2AC \uD615\uD0DC\uB85C \uC5F0\uACB0</b></color>\uB418\uB294
      \uD604\uC0C1\uC774 \uAD00\uCC30\uB418\uC5C8\uB2E4.\n\uB610\uD55C, <color=#FFCC00><b>\uACB0\uC815
      \uC0AC\uC2AC \uC8FC\uBCC0\uC73C\uB85C \uBD89\uC740 \uC138\uD3EC \uC870\uC9C1\uC774
      \uBD80\uCC29</b></color>\uB418\uB294 \uD604\uC0C1\uC774 \uD655\uC778\uB418\uC5C8\uB2E4.\n\uBD88\uC644\uC804\uD55C
      \uC870\uD569\uBB3C\uC740 \uD574\uB2F9 \uAD6C\uC870\uAC00 \uD615\uC131\uB418\uC9C0
      \uC54A\uC73C\uBA70 \uC77C\uC815 \uC2DC\uAC04 \uC774\uD6C4 \uBE60\uB974\uAC8C
      \uADE0\uC5F4\uB418\uC5B4 \uBD95\uAD34\uD558\uBA70 \uAC80\uC740\uC0C9\uC73C\uB85C
      \uC138\uD3EC\uAC00 \uBCC0\uC9C8\uB41C\uB2E4.\n\n<b>[ \uC0DD\uCCB4 \uB370\uC774\uD130
      \uD63C\uD569 \uAC80\uC0AC ]</b>\n\uD398\uD2B8\uB9AC \uC811\uC2DC\uC758 \uD63C\uD569\uBB3C\uC5D0
      \uAC10\uC5FC\uCCB4\uC758 \uC0DD\uCCB4 \uB370\uC774\uD130\uB97C \uD63C\uD569\uD558\uC5EC
      \uBC18\uC751\uC744 \uD655\uC778\uD55C\uB2E4.\n\u25CF <b>\uC815\uC0C1:</b> \uAD6C\uC870\uAC00
      \uC548\uC815\uC801\uC73C\uB85C \uC720\uC9C0\uB418\uBA70 <color=#FFCC00><b>\uC120\uBA85\uD55C
      \uBD89\uC740\uC0C9</b></color>\uC744 \uB764\uB2E4.\n\u25CF <b>\uC624\uC5FC:</b>
      \uBC18\uC751 \uC9C1\uD6C4 \uAE09\uC18D\uD788 \uBCC0\uC9C8\uB418\uBA70 <color=#FFCC00><b>\uAC80\uC740\uC0C9</b></color>\uC73C\uB85C
      \uBCC0\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1440805183479811
    m_Localized: "#01 \uC804\uC774 \uB2E8\uACC4 \uCD94\uC801 \uAE30\uB85D"
    m_Metadata:
      m_Items: []
  - m_Id: 1440805183479812
    m_Localized: "\n<b>\uAC1C\uC694</b>\nX \uACC4\uC5F4 \uBCC0\uC774 \uC778\uC790\uC5D0
      \uAC10\uC5FC\uB41C \uC2E4\uD5D8\uCCB4\uC758 \uCCB4\uC628 \uBCC0\uD654 \uBC0F
      \uD589\uB3D9 \uD328\uD134 \uC804\uC774 \uACFC\uC815 \uAD00\uCC30 \uAE30\uB85D.\n\n<b>[
      \uB2E8\uACC4\uBCC4 \uAD00\uCC30 \uAE30\uB85D ]</b>\n<size=80%><color=#AAAAAA><pos=7%>\uAD00\uCC30\uB41C
      \uC99D\uC0C1 \uBC0F \uD589\uB3D9 \uC9D5\uD6C4<pos=52%>\uCE21\uC815 \uCCB4\uC628<pos=77%>\uAE30\uB85D
      \uC77C\uC790</color></size>\n------------------------------------------------------------\n
      \uD2B9\uC774\uC0AC\uD56D \uC5C6\uC74C. \uB300\uC0C1\uCCB4 \uC815\uC0C1<pos=55%>37\uB3C4<pos=75%>2004-03-01\n
      \uC804\uB4F1\uC5D0 \uADF9\uC2EC\uD55C \uACE0\uD1B5 \uBC18\uC751<pos=55%>38\uB3C4<pos=75%>2004-03-03\n
      \uACE0\uC8FC\uD30C \uC18C\uC74C\uC5D0 \uACFC\uBBFC\uD55C \uBC18\uC751<pos=55%>40\uB3C4<pos=75%>2004-03-06\n
      \uC678\uACE8\uACA9 \uC790\uC720\uC790\uC7AC\uB85C \uC870\uC808 \uAC00\uB2A5<pos=55%>42\uB3C4<pos=75%>2004-03-10\n
      <color=#FF4444>\uCE21\uC815 \uBD88\uB2A5 (ERROR)</color><pos=55%><color=#FF4444>44\uB3C4</color><pos=75%>2004-03-17\n------------------------------------------------------------\n\n<b>[
      \uD2B9\uC774 \uC0AC\uD56D ]</b>\n\uCCB4\uC628 \uC0C1\uC2B9\uACFC \uD568\uAED8
      \uACF5\uACA9\uC131, \uAC10\uAC01 \uACFC\uBBFC \uBC18\uC751, \uACE8\uACA9 \uBCC0\uD615
      \uC18D\uB3C4\uAC00 \uBE44\uB840\uC801\uC73C\uB85C \uC99D\uAC00\uD558\uB294
      \uD604\uC0C1\uC774 \uD655\uC778\uB418\uC5C8\uB2E4.\n42\uB3C4 \uC774\uD6C4\uBD80\uD130
      \uB300\uC0C1\uCCB4\uB294 \uC678\uBD80 \uC790\uADF9 \uC5C6\uC774\uB3C4 \uC9C0\uC18D\uC801\uC778
      \uBCBD\uBA74 \uACF5\uACA9 \uD589\uB3D9\uC744 \uBC18\uBCF5\uD558\uC600\uC73C\uBA70,
      \uCCB4\uB0B4 \uACE8\uACA9 \uAD6C\uC870\uAC00 \uBE44\uC815\uC0C1\uC801\uC73C\uB85C
      \uD33D\uCC3D\uD558\uAE30 \uC2DC\uC791\uD588\uB2E4.\n\n<b>[ \uAE34\uAE09 \uAE30\uB85D
      ]</b>  <size=80%><color=#AAAAAA>2004-03-17 20:13:22</color></size>\n<color=#FF4444>\uC2E4\uD5D8\uCCB4\uC758
      \uCCB4\uC628\uC774 43.8\uB3C4\uC5D0 \uB3C4\uB2EC\uD568\uACFC \uB3D9\uC2DC\uC5D0
      \uACA9\uB9AC\uC2E4 \uB0B4\uBD80 \uCE21\uC815 \uC7A5\uBE44 \uC804\uBD80 \uACFC\uBD80\uD558
      \uBC1C\uC0DD.\n\uC2E4\uD5D8\uCCB4\uC758 \uCC99\uCD94 \uC870\uC9C1\uC774 \uAE09\uC18D\uB3C4\uB85C
      \uB3CC\uCD9C\uB418\uAE30 \uC2DC\uC791\uD588\uC73C\uBA70, \uAE30\uC874 \uC778\uAC04\uD615
      \uACE8\uACA9 \uAD6C\uC870 \uC720\uC9C0 \uBD88\uAC00\uB2A5 \uC0C1\uD0DC\uB85C
      \uD310\uB2E8\uB428.\n44\uB3C4 \uC9C4\uC785 \uC608\uC0C1 \uC2DC\uAC04 \uC57D
      30\uCD08.\n\uD604 \uC2DC\uC810\uBD80\uB85C \uBAA8\uB4E0 \uC5F0\uAD6C\uC6D0
      \uCCA0\uC218 \uBA85\uB839 \uC2DC\uD589.</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 1440805183479813
    m_Localized: "#02 \uAD11\uD559 \uC790\uADF9 \uBC18\uC751"
    m_Metadata:
      m_Items: []
  - m_Id: 1440805183479814
    m_Localized: "\n<b>\uAC1C\uC694</b>\n\uBCC0\uC774 \uC2E4\uD5D8\uCCB4\uC758 \uD2B9\uC815
      \uD30C\uC7A5 \uAD11\uC6D0 \uB178\uCD9C \uC2DC \uBC1C\uC0DD\uD558\uB294 \uC0DD\uCCB4
      \uBC18\uC751 \uBC0F \uC870\uC9C1 \uBCC0\uD654 \uBD84\uC11D.\n\n<b>[ \uC2E4\uD5D8
      \uB300\uC0C1 ]</b>\n\uC0AC\uC6A9 \uC7A5\uBE44: \uACE0\uCD9C\uB825 \uAD11\uC790
      \uC870\uC0AC\uAE30\n\uBD84\uC11D \uC778\uC790: <b>X1 \uC778\uC790</b>\n\n<b>[
      \uAD00\uCC30 \uB370\uC774\uD130 ]</b>\n\uB300\uC0C1\uCCB4\uB294 \uD2B9\uC815
      \uD30C\uC7A5\uC758 \uBE5B\uC5D0 \uB178\uCD9C\uB420 \uACBD\uC6B0 \uC989\uAC01\uC801\uC778
      \uD68C\uD53C \uBC18\uC751\uC744 \uBCF4\uC600\uB2E4.\n\uCD08\uAE30 \uB2E8\uACC4\uC5D0\uC11C\uB294
      \uB2E8\uC21C \uACBD\uB828 \uC218\uC900\uC774\uC5C8\uC73C\uB098, \uB178\uCD9C
      \uC2DC\uAC04\uC774 \uC99D\uAC00\uD560\uC218\uB85D \uC678\uACE8\uACA9 \uD45C\uBA74
      \uADE0\uC5F4 \uBC0F \uC870\uC9C1 \uBD95\uAD34 \uD604\uC0C1\uC774 \uBC1C\uC0DD\uD55C\uB2E4.\n\uB300\uC0C1\uCCB4\uC758
      \uB4F1 \uBD80\uC704 \uC678\uACE8\uACA9\uC774 \uBE44\uC815\uC0C1\uC801\uC73C\uB85C
      \uAC08\uB77C\uC9C0\uBA70 \uB0B4\uBD80 \uC870\uC9C1\uC774 \uB3CC\uCD9C\uB418\uAE30
      \uC2DC\uC791\uD558\uC600\uB2E4.\n\uC774\uD6C4 <color=#FF4444><b>\uCC99\uCD94
      \uC591\uCE21\uC5D0\uC11C \uC0C8\uB85C\uC6B4 \uAD00\uC808 \uAD6C\uC870\uAC00
      \uD615\uC131</b></color>\uB418\uC5C8\uC73C\uBA70, \uC0C8\uB86D\uAC8C \uD615\uC131\uB41C
      \uC870\uC9C1\uC740 \uAE30\uC874 \uACE8\uACA9\uACFC \uB3C5\uB9BD\uC801\uC73C\uB85C
      \uC6C0\uC9C1\uC600\uB2E4.\n\n<b>[ \uBD84\uC11D \uACB0\uACFC ]</b>\n<color=#FF4444><b>\uCCB4\uB0B4
      \uC794\uB958 \uC911\uC778 X1 \uC778\uC790\uAC00 \uC678\uBD80 \uAD11\uC790 \uC790\uADF9\uACFC
      \uBC18\uC751\uD558\uC5EC \uC2E0\uACBD\uACC4\uB97C \uACFC\uC790\uADF9\uD558\uB294
      \uAC83\uC73C\uB85C \uD310\uB2E8\uB41C\uB2E4.</b></color>\n\uAC15\uD55C \uAD11
      \uC790\uADF9 \uD658\uACBD\uC5D0\uC11C\uB294 \uC138\uD3EC \uBCC0\uC774 \uC18D\uB3C4\uAC00
      \uAE09\uACA9\uD788 \uC99D\uAC00\uD558\uBA70, \uC5B5\uC81C\uB418\uC5B4 \uC788\uB358
      \uC870\uC9C1 \uC7AC\uAD6C\uC131\uC774 \uD3ED\uBC1C\uC801\uC73C\uB85C \uC9C4\uD589\uB418\uB294
      \uD604\uC0C1\uC774 \uD655\uC778\uB418\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1440805183479815
    m_Localized: "#03 \uC74C\uD5A5 \uC790\uADF9 \uBC18\uC751"
    m_Metadata:
      m_Items: []
  - m_Id: 1440805183479816
    m_Localized: "\n<b>\uAC1C\uC694</b>\n\uACE0\uC8FC\uD30C \uC74C\uD5A5 \uC790\uADF9
      \uD658\uACBD\uC5D0\uC11C \uBC1C\uC0DD\uD558\uB294 \uBCC0\uC774 \uC2E4\uD5D8\uCCB4\uC758
      \uC2E0\uACBD\uACC4 \uBC0F \uD589\uB3D9 \uBC18\uC751 \uBD84\uC11D.\n\n<b>[ \uC2E4\uD5D8
      \uB300\uC0C1 ]</b>\n\uC0AC\uC6A9 \uC7A5\uBE44: \uACE0\uC8FC\uD30C \uBC1C\uC0DD\uAE30\n\uBD84\uC11D
      \uC778\uC790: <color=#FF4444><b>X2 \uC778\uC790</b></color>\n\n<b>[ \uAD00\uCC30
      \uB370\uC774\uD130 ]</b>\n\uC77C\uC815 \uC8FC\uD30C\uC218 \uC774\uC0C1\uC758
      \uACE0\uC8FC\uD30C \uC18C\uC74C \uBC1C\uC0DD \uC2DC \uB300\uC0C1\uCCB4\uC758
      \uACF5\uACA9\uC131\uC774 \uAE09\uACA9\uD788 \uC99D\uAC00\uD558\uB294 \uD604\uC0C1\uC774
      \uD655\uC778\uB418\uC5C8\uB2E4.\n\uB300\uC0C1\uCCB4\uB294 \uC74C\uD5A5 \uBC1C\uC0DD
      \uC7A5\uCE58\uB97C \uD5A5\uD574 \uBC18\uBCF5\uC801\uC778 \uB3CC\uC9C4 \uD589\uB3D9\uC744
      \uBCF4\uC600\uC73C\uBA70, \uADFC\uC721 \uACBD\uC9C1 \uBC0F \uCC99\uCD94 \uBC18\uC0AC
      \uBC18\uC751 \uB610\uD55C \uBE44\uC815\uC0C1\uC801\uC73C\uB85C \uC0C1\uC2B9\uD55C\uB2E4.\n\uC774\uD6C4
      \uC57D 40~60\uCD08 \uACBD\uACFC \uC2DC \uC804\uC2E0 \uB9C8\uBE44 \uC0C1\uD0DC\uC5D0
      \uBE60\uC84C\uB2E4.\n\n<b>[ \uBD84\uC11D \uACB0\uACFC ]</b>\n<color=#FF4444><b>\uBCC0\uC774
      \uACFC\uC815\uC5D0\uC11C \uD615\uC131\uB41C X2 \uC778\uC790\uAC00 \uCCAD\uAC01
      \uAE30\uAD00 \uC218\uC6A9\uCCB4\uB97C \uBE44\uC815\uC0C1\uC801\uC73C\uB85C
      \uBE44\uB300\uD654\uC2DC\uD0A8 \uAC83\uC73C\uB85C \uD310\uB2E8\uB41C\uB2E4.</b></color>\n\uD2B9\uC815
      \uC8FC\uD30C\uC218 \uB300\uC5ED\uC5D0\uC11C \uC2E0\uACBD \uD765\uBD84 \uC218\uCE58\uAC00
      \uD3ED\uBC1C\uC801\uC73C\uB85C \uC99D\uAC00\uD55C\uB2E4.\n"
    m_Metadata:
      m_Items: []
  - m_Id: 1440805183479817
    m_Localized: "\uC2EC\uC5F0 \uD3EC\uC2DD\uAC8C"
    m_Metadata:
      m_Items: []
  - m_Id: 1440805183479818
    m_Localized: "\u25CF \uC678\uACE8\uACA9\uC774 \uBE44\uC815\uC0C1\uC801\uC73C\uB85C
      \uBC1C\uB2EC\uD55C \uAC70\uB300 \uAC11\uAC01\uB958.\n\u25CF \uADF9\uB2E8\uC801\uC778
      \uD658\uACBD \uC801\uC751 \uC720\uC804\uC790\uB97C \uBCF4\uC720\uD558\uACE0
      \uC788\uC73C\uBA70, \uCCB4\uB0B4 \uBBF8\uB124\uB784 \uC131\uBD84\uC774 \uD2B9\uC815
      \uC778\uC790\uC640 \uBC18\uC751\uD558\uC5EC <color=#FF8C00>\uAC15\uB825\uD55C
      \uACBD\uD654 \uBC18\uC751</color>\uC744 \uC77C\uC73C\uD0B4."
    m_Metadata:
      m_Items: []
  - m_Id: 1440805183479819
    m_Localized: "\uD06C\uB9AC\uC2A4\uD0C8 \uC2A4\uCF00\uC77C \uB4DC\uB798\uACE4\uD53C\uC2DC"
    m_Metadata:
      m_Items: []
  - m_Id: 1440805183479820
    m_Localized: "\u25CF \uC2EC\uD574 5,000m \uC774\uD558\uC758 <b>\uADF9\uC800\uC628\xB7\uACE0\uC555
      \uD658\uACBD</b>\uC5D0 \uCD5C\uC801\uD654\uB41C \uD3EC\uC2DD\uC131 \uC2EC\uD574\uC5B4.\n\u25CF
      \uCCB4\uB0B4\uC5D0 \uBCF5\uD569 \uC5B5\uC81C \uC778\uC790\uB97C \uBCF4\uC720\uD558\uACE0
      \uC788\uC5B4 \uD0C0 \uC131\uBD84\uACFC\uC758 \uD63C\uD569 \uC2DC <color=#00FFFF>\uC911\uD654
      \uC791\uC6A9</color>\uC744 \uC77C\uC73C\uD0B4."
    m_Metadata:
      m_Items: []
  - m_Id: 1440805183479821
    m_Localized: "\uBE14\uB799\uB9AC\uBC84 \uB9AC\uCE58"
    m_Metadata:
      m_Items: []
  - m_Id: 1440805183479822
    m_Localized: "\u25CF \uC720\uAE30\uBB3C\uC744 \uD761\uC218\uD558\uC5EC \uBCC0\uC774
      \uCD09\uC9C4 \uC810\uC561\uC73C\uB85C \uCE58\uD658\uD558\uB294 \uBB34\uCC99\uCD94\uB3D9\uBB3C.\n\u25CF
      <color=#FF0000>\uCCB4\uB0B4 \uAC00\uC2A4 \uC8FC\uBA38\uB2C8\uB97C \uD1B5\uD55C
      \uD655\uC0B0 \uB2A5\uB825</color>\uC744 \uBCF4\uC720\uD558\uACE0 \uC788\uC73C\uBA70,
      \uBCC0\uC774 \uAE30\uC804\uC758 \uD575\uC2EC\uC778 H2 \uC778\uC790\uB97C \uB2E4\uB7C9
      \uD568\uC720\uD568."
    m_Metadata:
      m_Items: []
  - m_Id: 1440805183479823
    m_Localized: "\uC544\uBE44\uC124 \uBA74\uC5ED \uBB38\uC5B4"
    m_Metadata:
      m_Items: []
  - m_Id: 1440805183479824
    m_Localized: "\u25CF \uADF9\uC2EC\uD55C \uC218\uC555 \uD658\uACBD\uC5D0\uC11C
      \uC0DD\uC874\uD558\uAE30 \uC704\uD574 <b>\uACFC\uD65C\uC131 \uBA74\uC5ED \uCCB4\uACC4(Hyper-active
      Immune System)</b>\uB97C \uC9C4\uD654\uC2DC\uD0A8 \uAC1C\uCCB4.\n\u25CF \uCD09\uC218
      \uC810\uC561 \uB0B4 \uD2B9\uC815 \uD6A8\uC18C\uAC00 \uBA74\uC5ED \uC138\uD3EC\uC758
      \uD3ED\uBC1C\uC801 \uC99D\uC2DD\uC744 \uC720\uB3C4\uD558\uBA70, \uC870\uC9C1
      \uC7AC\uC0DD \uC18D\uB3C4\uAC00 \uBE44\uC815\uC0C1\uC801\uC73C\uB85C \uBE60\uB984.\n\u25CF
      \uC77C\uBD80 \uC2E4\uD5D8\uCCB4\uC5D0\uC11C <b>\uC81C\uC5B4\uB418\uC9C0 \uC54A\uB294
      <color=#FFCC00>\uC138\uD3EC \uACFC\uC99D\uC2DD</color></b> \uD604\uC0C1 \uBCF4\uACE0\uB428."
    m_Metadata:
      m_Items: []
  - m_Id: 1440805183479825
    m_Localized: "\uC7AC\uC0DD \uACE8\uC218 \uD574\uB9C8"
    m_Metadata:
      m_Items: []
  - m_Id: 1440805183479826
    m_Localized: "\u25CF \uC2EC\uD574 \uC5F4\uC218 \uBD84\uCD9C\uACF5 \uADFC\uCC98\uC5D0\uC11C
      \uC11C\uC2DD\uD558\uB294 \uD2B9\uC774 \uD574\uB9C8\uB958.\n\u25CF <b>\uACE8\uC218
      \uD65C\uB3D9</b>\uC774 \uB9E4\uC6B0 \uD65C\uBC1C\uD558\uC5EC \uACE8\uACA9 \uC808\uB2E8
      \uC2DC\uC5D0\uB3C4 \uC989\uAC01\uC801\uC778 \uC790\uAC00 \uBCF5\uC6D0\uC774
      \uAC00\uB2A5\uD568.\n\u25CF <color=#00FF7F>\uACFC\uD65C\uC131 \uBA74\uC5ED\uC744
      \uC9C4\uC815</color>\uC2DC\uD0A4\uB294 \uC548\uC815 \uC778\uC790\uB97C \uBCF4\uC720\uD568."
    m_Metadata:
      m_Items: []
  - m_Id: 1538993072562176
    m_Localized: "<b>\uC544\uBE44\uC124 \uBA74\uC5ED\uBB38\uC5B4 \uBC1C\uAD11\uCCB4</b>
      \uC870\uC9C1\uC758 \uBA74\uC5ED \uBC18\uC751 \uBD84\uC11D"
    m_Metadata:
      m_Items: []
  - m_Id: 1538993206779904
    m_Localized: "<b>\uBE14\uB799\uB9AC\uBC84 \uB9AC\uCE58</b>\uC758 \uC0DD\uCCB4
      \uB300\uC0AC \uC5B5\uC81C \uBC18\uC751 \uBD84\uC11D"
    m_Metadata:
      m_Items: []
  - m_Id: 1538993206779905
    m_Localized: "<b>\uD06C\uB9AC\uC2A4\uD0C8 \uC2A4\uCF00\uC77C \uB4DC\uB798\uACE4
      \uD53C\uC2DC \uC678\uD53C</b>\uC758 \uC5F4\uC5ED\uD559 \uBC18\uC751 \uBD84\uC11D"
    m_Metadata:
      m_Items: []
  - m_Id: 1538993206779906
    m_Localized: "<b>\uCCAD\uC0C9 \uACB0\uC815 \uC0AC\uC2AC</b> \uAD6C\uC870 \uBC0F
      <b>\uBD89\uC740 \uC138\uD3EC</b> \uBC18\uC751 <b>\uC548\uC815\uC131</b> \uAD00\uCC30
      \uAE30\uB85D"
    m_Metadata:
      m_Items: []
  - m_Id: 1538993206779907
    m_Localized: "<b>X \uACC4\uC5F4</b> \uBCC0\uC774 \uC778\uC790 \uAC10\uC5FC \uC2E4\uD5D8\uCCB4\uC758
      <b>\uCCB4\uC628 \uBCC0\uD654</b> \uBC0F <b>\uD589\uB3D9</b> \uAD00\uCC30 \uAE30\uB85D"
    m_Metadata:
      m_Items: []
  - m_Id: 1538993206779908
    m_Localized: "<b>\uD2B9\uC815 \uD30C\uC7A5 \uAD11\uC6D0</b>\uC5D0 \uC2E4\uD5D8\uCCB4\uAC00
      \uB178\uCD9C\uB420 \uC2DC \uBC1C\uC0DD\uD558\uB294 \uC0DD\uCCB4 \uBC18\uC751
      \uBC0F \uC870\uC9C1 \uBCC0\uD654 \uBD84\uC11D"
    m_Metadata:
      m_Items: []
  - m_Id: 1538993206779909
    m_Localized: "<b>\uACE0\uC8FC\uD30C \uC74C\uD5A5</b> \uC790\uADF9 \uD658\uACBD\uC5D0\uC11C
      \uBC1C\uC0DD\uD558\uB294 \uC2E4\uD5D8\uCCB4\uC758 \uC2E0\uACBD\uACC4 \uBC0F
      \uD589\uB3D9 \uBC18\uC751 \uBD84\uC11D"
    m_Metadata:
      m_Items: []
  - m_Id: 1546705013497856
    m_Localized: "\uC2E4\uD5D8 \uAE30\uB85D"
    m_Metadata:
      m_Items: []
  - m_Id: 1546705109966848
    m_Localized: "\uC885 \uBAA9\uB85D"
    m_Metadata:
      m_Items: []
  - m_Id: 1546705109966849
    m_Localized: "\uC0DD\uBB3C\uD559\uC801 \uD2B9\uC9D5"
    m_Metadata:
      m_Items: []
  - m_Id: 1546705109966850
    m_Localized: "\uC0D8\uD50C"
    m_Metadata:
      m_Items: []
  - m_Id: 1559942241116160
    m_Localized: "\uC624\uB298\uBD80\uD130 <color=#C80000>\uC2EC\uD574 \uC0DD\uBB3C
      \uD0D0\uC0AC \uC784\uBB34</color>\uC5D0 \uD22C\uC785\uB41C\uB2E4. \n\n\uCD9C\uD56D
      \uC804 \uBD80\uB450\uC5D0\uB294 \uC5D8\uB808\uB098\uC640 \uC18C\uD53C\uC544,
      \uB8E8\uCE74\uC2A4\uAC00 \uB098\uC640 \uBC30\uC6C5\uD574 \uC8FC\uC5C8\uB2E4.
      \uBC84\uB514\uB791 \uCC30\uB9AC\uB3C4 \uC2E0\uB098\uAC8C \uB6F0\uC5B4\uB2E4\uB2C8\uBA70
      \uB098\uB97C \uBC18\uACA8\uC92C\uB2E4. \uB5A0\uB098\uB294 \uC21C\uAC04\uAE4C\uC9C0\uB3C4
      \uC544\uC774\uB4E4\uC740 \uC6C3\uACE0 \uC788\uC5C8\uC9C0\uB9CC, \uC5D8\uB808\uB098\uB294
      \uC560\uC368 \uAC71\uC815\uC744 \uC228\uAE30\uACE0 \uC788\uB294 \uAC8C \uB208\uC5D0
      \uBCF4\uC600\uB2E4.\n\n\uC7A0\uC218\uD568\uC5D0 \uB3C4\uCC29\uD558\uC790\uB9C8\uC790
      \uBC30\uC815\uBC1B\uC740 \uBC29\uC744 \uC815\uB9AC\uD588\uB2E4. \uB77C\uCEE4
      \uBB38 \uC548\uCABD\uC5D0\uB294 \uC18C\uD53C\uC544\uAC00 \uADF8\uB824\uC900
      \uAC00\uC871 \uADF8\uB9BC\uACFC \uBC84\uB514, \uCC30\uB9AC \uC0AC\uC9C4\uC744
      \uBD99\uC5EC\uB450\uC5C8\uB2E4. \uB77C\uCEE4\uB97C \uC5F4 \uB54C\uB9C8\uB2E4
      \uAC00\uC871 \uC5BC\uAD74\uC744 \uBCFC \uC218 \uC788\uC73C\uB2C8 \uC870\uAE08\uC740
      \uBC84\uD2F8 \uD798\uC774 \uB0A0 \uAC83 \uAC19\uB2E4. \uAC00\uC871\uC744 \uB450\uACE0
      \uC2EC\uD574\uB85C \uB4E4\uC5B4\uAC00\uB294 \uAC74 \uC5EC\uC804\uD788 \uC27D\uC9C0
      \uC54A\uB2E4. \uADF8\uB798\uB3C4 \uC544\uC9C1 \uC138\uC0C1\uC5D0 \uC54C\uB824\uC9C0\uC9C0
      \uC54A\uC740 \uC2EC\uD574 \uC0DD\uBB3C\uC744 \uC9C1\uC811 \uD0D0\uC0C9\uD558\uACE0
      \uD3EC\uD68D\uD560 \uC218 \uC788\uB2E4\uB294 \uC0DD\uAC01\uC5D0 \uB9C8\uC74C
      \uD55C\uD3B8\uC774 \uC124\uB80C\uB2E4. \n\n\uC6B0\uB9AC\uAC00 \uD655\uBCF4\uD55C
      \uC0DD\uBB3C\uB4E4\uC740 \uC5F0\uAD6C\uC6D0\uB4E4\uC5D0\uAC8C \uC804\uB2EC\uB418\uACE0,
      \uADF8 \uC5F0\uAD6C\uAC00 \uC5B8\uC820\uAC00\uB294 \uC0C8\uB85C\uC6B4 \uCE58\uB8CC\uC81C\uB098
      \uAE30\uC220 \uAC1C\uBC1C\uB85C \uC774\uC5B4\uC838 \uB9CE\uC740 \uC0AC\uB78C\uB4E4\uC5D0\uAC8C
      \uB3C4\uC6C0\uC774 \uB420\uC9C0\uB3C4 \uBAA8\uB978\uB2E4. \uC704\uD5D8\uD55C
      \uC784\uBB34\uC9C0\uB9CC \uADF8\uB9CC\uD55C \uAC00\uCE58\uAC00 \uC788\uB2E4\uACE0
      \uBBFF\uB294\uB2E4. \uC774\uBC88 \uC784\uBB34\uB3C4 \uBAA8\uB450 \uBB34\uC0AC\uD788
      \uB9C8\uCE58\uACE0 \uAC00\uC871 \uACC1\uC73C\uB85C \uB3CC\uC544\uAC00\uC57C\uACA0\uB2E4.\n\n\uB8F8\uBA54\uC774\uD2B8\uB294
      \uB0B4 \uBD80\uD558\uC778 \uC5D0\uB7F0 \uB2E4\uC774\uC5B4\uB2E4. \uD0D1\uC2B9\uD558\uB294
      \uB0B4\uB0B4 \uAE34\uC7A5\uD55C \uD45C\uC815\uC774\uC5C8\uB2E4. \uC2EC\uD574
      \uC0DD\uBB3C\uC744 \uC2E4\uC81C\uB85C \uBCF4\uB294 \uAC74 \uCC98\uC74C\uC774\uB77C\uB294\uB370,
      \uC774\uB807\uAC8C \uAC81\uC774 \uB9CE\uC544\uC11C\uC57C \uD3EC\uD68D \uC784\uBB34\uB97C
      \uC81C\uB300\uB85C \uD560 \uC218 \uC788\uC744\uC9C0 \uBAA8\uB974\uACA0\uB2E4.
      \uADF8\uB798\uB3C4 \uACBD\uD5D8\uC744 \uC313\uB2E4 \uBCF4\uBA74 \uC870\uAE08\uC529
      \uB098\uC544\uC9C0\uACA0\uC9C0. \n\n"
    m_Metadata:
      m_Items: []
  - m_Id: 1559942371139584
    m_Localized: "\uC624\uB298\uC740 \uCCAB \uC21C\uCC30\uACFC \uC7A5\uBE44 \uC810\uAC80\uC744
      \uD588\uB2E4.\n\n\uC5F0\uAD6C\uC6D0\uB4E4\uC740 \uD558\uB8E8 \uC885\uC77C \uC0C8\uB85C\uC6B4
      \uC2EC\uD574 \uC0DD\uBB3C \uD45C\uBCF8\uC744 \uBD84\uC11D\uD558\uB290\uB77C
      \uC815\uC2E0\uC774 \uC5C6\uC5C8\uB2E4. \uC6B0\uB9AC \uC785\uC7A5\uC5D0\uC11C\uB294
      \uC704\uD5D8\uD55C \uC0DD\uBB3C\uC774\uC9C0\uB9CC, \uC5F0\uAD6C\uC6D0\uB4E4
      \uB208\uC5D0\uB294 \uADC0\uC911\uD55C \uC5F0\uAD6C \uC790\uB8CC\uC778 \uBAA8\uC591\uC774\uB2E4.\n\n\uC2DD\uB2F9\uC5D0\uC11C
      \uD074\uB85C\uC774 \uB808\uC774\uB180\uC988\uC640 \uC7A0\uAE50 \uC774\uC57C\uAE30\uB97C
      \uB098\uB234\uB2E4. \uC5F0\uAD6C \uC598\uAE30\uB97C \uC2DC\uC791\uD558\uBA74
      \uC2DC\uAC04 \uAC00\uB294 \uC904 \uBAA8\uB974\uB294 \uC0AC\uB78C\uC774\uB2E4.\n\n\uC5D0\uB7F0\uC740
      \uC5EC\uC804\uD788 \uC5F0\uAD6C\uC2E4 \uADFC\uCC98\uB97C \uC9C0\uB098\uAC08
      \uB54C\uB9C8\uB2E4 \uC794\uB729 \uAE34\uC7A5\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1559942371139585
    m_Localized: "\uC624\uB298\uC740 <color=#C80000>\uB85C\uBC84\uD2B8 \uD5E4\uC774\uC988
      \uC9C0\uD718\uAD00\uB2D8</color>\uC758 \uC0DD\uC2E0\uC774\uC5C8\uB2E4.\n\n\uD3C9\uC18C\uC5D0\uB294
      \uC791\uC740 \uC2E4\uC218\uB3C4 \uADF8\uB0E5 \uB118\uAE30\uC9C0 \uC54A\uC73C\uC2E4
      \uB9CC\uD07C \uC5C4\uACA9\uD55C \uBD84\uC774\uC9C0\uB9CC, \uB300\uC6D0\uB4E4\uC774
      \uC900\uBE44\uD55C \uC791\uC740 \uCD95\uD558 \uC790\uB9AC\uC5D0\uC11C\uB294
      \uB4DC\uBB3C\uAC8C \uBBF8\uC18C\uB97C \uBCF4\uC5EC\uC8FC\uC168\uB2E4. \uC7A0\uC218\uD568
      \uC548 \uBD84\uC704\uAE30\uB3C4 \uC624\uB79C\uB9CC\uC5D0 \uBC1D\uC544\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1559942371139586
    m_Localized: "\uC624\uB298\uC740 \uC7A0\uC218\uD568 \uBC16\uC73C\uB85C \uB098\uAC00
      \uC0C8\uB85C\uC6B4 \uC2EC\uD574 \uC0DD\uBB3C \uD0D0\uC0AC\uB97C \uC9C4\uD589\uD588\uB2E4.\n\n\uC5B8\uC81C
      \uD574\uB3C4 <color=#C80000>\uD0C8\uCD9C\uC2E4</color>\uC5D0 \uB4E4\uC5B4\uAC00\uB294
      \uC21C\uAC04\uC740 \uAE34\uC7A5\uB41C\uB2E4. <color=#C80000>\uB0B4\uBD80 \uD574\uCE58\uB97C
      \uB2EB\uACE0</color> \uD574\uC218\uAC00 \uCC9C\uCC9C\uD788 \uCC28\uC624\uB97C
      \uB54C\uBA74 \uC228\uC774 \uD131 \uB9C9\uD788\uB294 \uAE30\uBD84\uC774\uB2E4.
      \uCC98\uC74C \uC774 \uC784\uBB34\uB97C \uB9E1\uC558\uC744 \uB54C\uB294 \uBB3C\uC774
      \uBAA9\uAE4C\uC9C0 \uCC28\uC624\uB974\uB294 \uAC83\uB9CC\uC73C\uB85C\uB3C4
      \uC2DD\uC740\uB540\uC774 \uB0AC\uC5C8\uB2E4.\n\n\uD558\uC9C0\uB9CC \uC9C4\uC9DC
      \uC911\uC694\uD55C \uAC74 \uADF8\uB2E4\uC74C\uC774\uB2E4. \uC678\uBD80 \uD574\uC218\uAC00
      \uBAA8\uB450 \uCC28\uBA74 \uC11C\uB450\uB974\uC9C0 \uB9D0\uACE0 <color=#C80000>\uC555\uB825\uC744
      \uBA3C\uC800 \uB9DE\uCDB0\uC57C \uD55C\uB2E4.</color> \uAE4A\uC740 \uBC14\uB2E4\uC5D0\uC11C\uB294
      \uC218\uC555\uC774 \uC21C\uC2DD\uAC04\uC5D0 \uBAB8\uC744 \uC9D3\uB204\uB974\uAE30
      \uB54C\uBB38\uC5D0 \uC774 \uACFC\uC815\uC744 \uAC74\uB108\uB6F0\uBA74 \uADC0\uAC00
      \uCC22\uC5B4\uC9C8 \uB4EF\uD55C \uD1B5\uC99D\uC774 \uCC3E\uC544\uC628\uB2E4.\n\n\uB098\uB294
      \uD56D\uC0C1 \uCF54\uB97C \uB9C9\uACE0 \uCC9C\uCC9C\uD788 \uC228\uC744 \uBC00\uC5B4
      \uB123\uC5B4 \uADC0 \uC548\uCABD \uC555\uB825\uC744 \uB9DE\uCD98 \uB4A4 \uBC16\uC73C\uB85C
      \uB098\uAC04\uB2E4. \uBAB8\uC774 \uAD1C\uCC2E\uB2E4\uACE0 \uB290\uAEF4\uC9C8
      \uB54C\uAE4C\uC9C0 \uBA87 \uBC88\uC774\uACE0 \uBC18\uBCF5\uD558\uB294 \uAC8C
      \uC694\uB839\uC774\uB2E4. \uAE09\uD558\uAC8C \uB098\uAC00\uB824\uB2E4 \uACE0\uC0DD\uD558\uB294
      \uC2E0\uC785\uB4E4\uC744 \uC5EC\uB7FF \uBD24\uB2E4.\n\n\uC624\uB298\uB3C4 \uC5D0\uB7F0\uC740
      \uAE34\uC7A5\uD55C \uB098\uBA38\uC9C0 \uC555\uB825 \uD3C9\uD615\uC744 \uC81C\uB300\uB85C
      \uB9DE\uCD94\uC9C0 \uBABB\uD574 \uADC0\uB97C \uBD99\uC7A1\uACE0 \uD55C\uCC38\uC744
      \uC778\uC0C1\uC744 \uCC0C\uD478\uB838\uB2E4. \uB140\uC11D\uC5D0\uAC8C\uB294
      \uBA87 \uBC88\uC774\uACE0 \uB9D0\uD588\uC9C0\uB9CC, \uC2EC\uD574\uC5D0\uC11C\uB294
      \uC11C\uB450\uB974\uB294 \uAC83\uBCF4\uB2E4 \uC808\uCC28\uB97C \uC9C0\uD0A4\uB294
      \uAC83\uC774 \uBAA9\uC228\uC744 \uC9C0\uD0A4\uB294 \uC77C\uC774\uB2E4.\n\n\uD0D0\uC0AC\uB294
      \uBB34\uC0AC\uD788 \uB05D\uB0AC\uACE0, \uCC98\uC74C \uBCF4\uB294 \uC2EC\uD574
      \uC0DD\uBB3C\uB3C4 \uD55C \uB9C8\uB9AC \uD655\uBCF4\uD588\uB2E4. \uC704\uD5D8\uC740
      \uB530\uB974\uC9C0\uB9CC \uC544\uC9C1 \uC138\uC0C1\uC5D0 \uC54C\uB824\uC9C0\uC9C0
      \uC54A\uC740 \uC0DD\uBB3C\uC744 \uC9C1\uC811 \uBC1C\uACAC\uD558\uB294 \uC21C\uAC04\uB9CC\uD07C\uC740
      \uC5B8\uC81C\uB098 \uAC00\uC2B4\uC774 \uB6F4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1559942371139587
    m_Localized: "\uADFC\uBB34\uB97C \uB9C8\uCE5C \uB4A4 \uC624\uB79C\uB9CC\uC5D0
      \uC6B4\uB3D9\uC744 \uD588\uB2E4. \uD3EC\uD68D \uC791\uC5C5\uC740 \uC0DD\uAC01\uBCF4\uB2E4
      \uCCB4\uB825\uC744 \uB9CE\uC774 \uC4F0\uAE30 \uB54C\uBB38\uC5D0 \uBAB8 \uAD00\uB9AC\uB294
      \uD544\uC218\uB2E4.\n\n\uC800\uB141\uC5D0\uB294 \uB300\uC6D0\uB4E4\uACFC \uCE74\uB4DC
      \uAC8C\uC784\uC744 \uD588\uB2E4. \uC5D0\uB7F0\uB3C4 \uCC98\uC74C\uC5D4 \uBA40\uB6B1\uD788
      \uBCF4\uACE0\uB9CC \uC788\uB2E4\uAC00 \uACB0\uAD6D \uB07C\uC5B4\uB4E4\uC5C8\uB294\uB370,
      \uC0DD\uAC01\uBCF4\uB2E4 \uC2B9\uBD80\uC695\uC774 \uAC15\uD574\uC11C \uB2E4\uB4E4
      \uC6C3\uC5C8\uB2E4.\n\n\uAD1C\uD788 \uD53C\uACE4\uD588\uB358 \uD558\uB8E8\uAC00
      \uC870\uAE08\uC740 \uAC00\uBCBC\uC6CC\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1559942371139588
    m_Localized: "\uC624\uB298\uB3C4 \uD0D0\uC0AC\uB294 \uC21C\uC870\uB85C\uC6E0\uB2E4.\n\n\uBA70\uCE60
      \uC804 \uD3EC\uD68D\uD588\uB358 \uC2EC\uD574 \uC0DD\uBB3C\uC744 \uC5F0\uAD6C\uD558\uB358
      \uD074\uB85C\uC774\uAC00 \uB4E4\uB72C \uD45C\uC815\uC73C\uB85C \uC0C8\uB85C\uC6B4
      \uC5F0\uAD6C \uACB0\uACFC\uB97C \uC124\uBA85\uD574 \uC8FC\uC5C8\uB2E4. \uC790\uAC00
      \uC7AC\uC0DD\uC744 \uC720\uB3C4\uD558\uB294 \uD608\uCCAD\uC744 \uCD94\uCD9C\uD558\uB294
      \uB370 \uC131\uACF5\uD588\uB2E4\uACE0 \uD55C\uB2E4. \uC544\uC9C1 \uC5F0\uAD6C
      \uB2E8\uACC4\uC9C0\uB9CC \uC5B8\uC820\uAC00\uB294 \uB9CE\uC740 \uC0AC\uB78C\uC744
      \uC0B4\uB9B4 \uC218\uB3C4 \uC788\uB2E4\uBA70 \uBB34\uCC99 \uAE30\uBED0\uD588\uB2E4.\n\n\uADF8
      \uC774\uC57C\uAE30\uB97C \uB4E3\uACE0 \uC788\uC73C\uB2C8 \uC704\uD5D8\uC744
      \uBB34\uB985\uC4F0\uACE0 \uC2EC\uD574\uAE4C\uC9C0 \uB0B4\uB824\uC624\uB294
      \uC774\uC720\uB97C \uC870\uAE08\uC740 \uC54C \uAC83 \uAC19\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1559942371139589
    m_Localized: "<color=#C80000>\uB2E4\uB2C8\uC5D8 \uBCF4\uC774\uB4DC \uC7A5\uAD50\uB2D8</color>\uC758
      \uC0DD\uC2E0\uC774 \uB0B4\uC77C\uC774\uB2E4.\n\n\uD56D\uC0C1 \uB300\uC6D0\uB4E4\uBD80\uD130
      \uCC59\uAE30\uB294 \uBD84\uC774\uB77C \uB2E4\uB4E4 \uC791\uC740 \uC120\uBB3C\uC744
      \uC900\uBE44\uD558\uACE0 \uC788\uB2E4. \uC774\uB7F0 \uD3D0\uC1C4\uB41C \uACF5\uAC04\uC5D0\uC11C\uB294
      \uC0AC\uC18C\uD55C \uC774\uBCA4\uD2B8 \uD558\uB098\uAC00 \uBD84\uC704\uAE30\uB97C
      \uAF64 \uBC14\uAFD4\uC900\uB2E4.\n\n\uC5D0\uB7F0\uB3C4 \uC7A5\uAD50\uB2D8\uAED8
      \uBB58 \uB4DC\uB9B4\uC9C0 \uC9C4\uC9C0\uD558\uAC8C \uACE0\uBBFC\uD558\uB294
      \uAC78 \uBCF4\uB2C8 \uC5B4\uB290 \uC815\uB3C4\uB294 \uC801\uC751\uD55C \uBAA8\uC591\uC774\uB2E4.
      \uCC98\uC74C \uD0D1\uC2B9\uD588\uC744 \uB54C\uBCF4\uB2E4\uB294 \uC5BC\uAD74\uC5D0
      \uC5EC\uC720\uAC00 \uC0DD\uACBC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1559942371139590
    m_Localized: "\uC624\uB298\uC740 \uD3C9\uC0DD \uC78A\uC9C0 \uBABB\uD560 \uB0A0\uC774
      \uB420 \uAC83 \uAC19\uB2E4.\n\n\uC5F0\uAD6C \uC911\uC774\uB358 \uC2EC\uD574
      \uC0DD\uBB3C \uD558\uB098\uAC00 \uAC11\uC790\uAE30 \uACA9\uB9AC \uAD6C\uC5ED\uC744
      \uB6AB\uACE0 \uD0C8\uCD9C\uD588\uB2E4. \uACBD\uBCF4\uAC00 \uC6B8\uB9AC\uC790\uB9C8\uC790
      \uACBD\uBE44 \uBD80\uB300\uB97C \uC774\uB04C\uACE0 \uD604\uC7A5\uC73C\uB85C
      \uB6F0\uC5B4\uAC14\uB2E4.\n\n\uB140\uC11D\uC740 \uB4F1\uC5D0 \uB3CB\uC740 <color=#C80000>\uB0A0\uCE74\uB85C\uC6B4
      \uAC00\uC2DC</color>\uB97C \uC0AC\uBC29\uC73C\uB85C \uC3D8\uC544\uB300\uBA70
      \uBBF8\uCE5C \uB4EF\uC774 \uB0A0\uB6F0\uC5C8\uB2E4. \uAC00\uAE4C\uC2A4\uB85C
      \uC81C\uC555\uD558\uAE34 \uD588\uC9C0\uB9CC \uAE34\uC7A5\uAC10 \uB54C\uBB38\uC5D0
      \uC544\uC9C1\uB3C4 \uC190\uB05D\uC774 \uB5A8\uB9AC\uB294 \uAE30\uBD84\uC774\uB2E4.\n\n\uBB34\uC5C7\uBCF4\uB2E4
      \uACC4\uC18D \uBA38\uB9BF\uC18D\uC744 \uB5A0\uB098\uC9C0 \uC54A\uB294 \uAC74
      \uB140\uC11D\uC758 \uBAA8\uC2B5\uC774\uB2E4. \uCCB4\uD615\uB3C4 \uADF8\uB807\uACE0
      \uC6C0\uC9C1\uC774\uB294 \uBC29\uC2DD\uB3C4 <color=#C80000>\uC0AC\uB78C</color>\uACFC
      \uB108\uBB34 \uB2EE\uC544 \uC788\uC5C8\uB2E4. \uB208\uC774 \uB9C8\uC8FC\uCE5C
      \uC21C\uAC04 \uB4F1\uACE8\uC774 \uC11C\uB298\uD574\uC84C\uB2E4. \uB2E8\uC21C\uD55C
      \uC2EC\uD574 \uC0DD\uBB3C\uC774\uB77C\uACE0 \uD558\uAE30\uC5D4 \uB108\uBB34
      \uAE30\uAD34\uD588\uB2E4.\n\n\uC624\uB298\uC740 \uC27D\uAC8C \uC7A0\uB4E4 \uC218
      \uC788\uC744 \uAC83 \uAC19\uC9C0 \uC54A\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1782114578522112
    m_Localized: "\uC775\uC219\uD55C \uC545\uBABD\uC758 \uC7AC\uD68C"
    m_Metadata:
      m_Items: []
  - m_Id: 1782114687574016
    m_Localized: "\uADF8\uAC83\uC740 \uD55C\uB54C \uB3D9\uB8CC\uC600\uB358 '\uBB34\uC5B8\uAC00'\uC600\uB2E4.\n\uB4F1
      \uB4A4\uB85C \uB3CB\uC544\uB09C \uAC70\uBBF8 \uAC19\uC740 \uB2E4\uB9AC\uB4E4\uC774
      \uAE08\uC18D \uBCF5\uB3C4\uB97C \uAE01\uC73C\uBA70 \uAE30\uAD34\uD55C \uC18D\uB3C4\uB85C
      \uB2E4\uAC00\uC628\uB2E4.\n.....\uB108\uC758 \uB9C8\uC9C0\uB9C9 \uBE44\uBA85\uC740
      \uCC22\uACA8\uB098\uAC04 \uC721\uC2E0 \uC0AC\uC774\uB85C \uD769\uC5B4\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1782114687574017
    m_Localized: "\uC2EC\uD574\uC758 \uB9C8\uCE68\uD45C"
    m_Metadata:
      m_Items: []
  - m_Id: 1782114687574018
    m_Localized: "\uAC70\uB300\uD55C \uC218\uC555\uACFC \uD568\uAED8 \uC7A0\uC218\uD568\uC774
      \uC694\uB3D9\uCCE4\uB2E4.\n\uC774\uC5B4\uC9C4 \uD3ED\uBC1C\uC74C\n\uC2EC\uD574\uC758
      \uAD34\uBB3C\uC740 \uACB0\uAD6D \uB108\uB97C \uCC3E\uC544\uB0C8\uB2E4.\n.....\uADF8\uB9AC\uACE0
      \uC544\uBB34\uAC83\uB3C4 \uB0A8\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1782114687574019
    m_Localized: "\uAC00\uC7A5 \uB0AE\uC740 \uACF3\uC73C\uB85C"
    m_Metadata:
      m_Items: []
  - m_Id: 1782114687574020
    m_Localized: "\uC911\uB825\uC740 \uB108\uB97C \uB354 \uAE4A\uC740 \uC2EC\uC5F0\uC73C\uB85C
      \uB04C\uC5B4\uB0B4\uB838\uB2E4.\n\uC9E7\uC740 \uBE44\uBA85 \uB05D\uC5D0 \uB4E4\uB824\uC628
      \uAC83\uC740 \uB454\uD0C1\uD55C \uD30C\uC5F4\uC74C\uBFD0.\n.....\uCC28\uB514\uCC2C
      \uC7A0\uC218\uD568\uC758 \uBC14\uB2E5\uC774 \uB108\uC758 \uB9C8\uC9C0\uB9C9
      \uCE68\uC0C1\uC774 \uB418\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1782114687574021
    m_Localized: "\uC624\uB9CC\uD55C \uD655\uC2E0\uC758 \uB300\uAC00"
    m_Metadata:
      m_Items: []
  - m_Id: 1782114687574022
    m_Localized: "\uACA8\uC6B0 \uC774\uB7F0 \uAC04\uB2E8\uD55C \uD37C\uC990\uC870\uCC28
      \uB9DE\uCD94\uC9C0 \uBABB\uD560 \uC904\uC774\uC57C.\n\uAD34\uBB3C\uC5D0\uAC8C
      \uBA39\uD788\uAE30\uB3C4 \uC804\uC5D0 \uC2A4\uC2A4\uB85C \uC790\uBA78\uD558\uB2E4\uB2C8\n\uC774\uBCF4\uB2E4
      \uC6B0\uC2A4\uAF5D\uC2A4\uB7EC\uC6B4 \uCD5C\uD6C4\uAC00 \uC788\uC744\uAE4C?\n.....\uC8FD\uC74C\uC870\uCC28
      \uB108\uC758 \uBA4D\uCCAD\uD568\uC744 \uAC00\uB824\uC8FC\uC9C0\uB294 \uBABB\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1782114687574023
    m_Localized: "\uC545\uBABD\uC758 \uB300\uBB3C\uB9BC"
    m_Metadata:
      m_Items: []
  - m_Id: 1782114687574024
    m_Localized: "\uB1CC\uAC00 \uB179\uC544\uB0B4\uB9B4 \uB4EF\uD55C \uACE0\uC5F4\uC774
      \uC628\uBAB8\uC744 \uC9C0\uBC30\uD588\uB2E4.\n\uB4F1 \uB4A4\uC758 \uC0B4\uAC17\uC744
      \uB6AB\uACE0 \uC870\uAE08\uC529 \uB3CB\uC544\uB098\uB358 \uAC00\uC2DC\uB4E4\uC740,
      \uACB0\uAD6D \uBF08\uB97C \uAE4E\uB294 \uACE0\uD1B5\uACFC \uD568\uAED8 \uC644\uC804\uD788
      \uC790\uB77C\uB098 \uAC70\uB300\uD55C \uD749\uAE30\uAC00 \uB418\uC5C8\uB2E4.\n\uC778\uAC04\uC758
      \uC721\uC2E0\uC774 \uBB34\uB108\uC9C4 \uC790\uB9AC\uC5D0 \uB9C8\uCE68\uB0B4
      \uC644\uBCBD\uD55C \uAD34\uBB3C\uC774 \uC6B0\uB69D \uC120\uB2E4.\n\uC778\uAC04\uC774\uC5C8\uB358
      '\uB108'\uC758 \uC774\uC131\uC740 \uCC28\uAC00\uC6B4 \uC2EC\uD574 \uC18D\uC73C\uB85C
      \uC601\uC6D0\uD788 \uC0AC\uBA78\uD588\uB2E4.\n.....\uC774\uC81C\uB294 \uB124\uAC00,
      \uB204\uAD70\uAC00\uC758 \uC775\uC219\uD55C \uC545\uBABD\uC774 \uB420 \uCC28\uB840\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1782114687574025
    m_Localized: "\uB354 \uD070 \uC2EC\uC5F0\uC758 \uB208\uB3D9\uC790"
    m_Metadata:
      m_Items: []
  - m_Id: 1782114687574026
    m_Localized: "\uAC00\uAE4C\uC2A4\uB85C \uD0C8\uCD9C\uC2E4\uC5D0 \uB3C4\uCC29\uD588\uB2E4.\n\uB108\uB294
      \uC774\uC81C\uC57C \uC548\uB3C4\uC758 \uC228\uC744 \uB0B4\uBC49\uB294\uB2E4.\n\uD558\uC9C0\uB9CC
      \uADF8\uAC83\uB3C4 \uC7A0\uC2DC, \uC7A0\uC218\uD568 \uBC16\uC740 \uAC70\uB300\uD55C
      '\uBB34\uC5B8\uAC00'\uAC00 \uB2E4\uAC00\uC624\uACE0 \uC788\uB2E4.\n....\uACFC\uC5F0
      \uB108\uB294 \uC9C4\uC815\uD55C '\uD0C8\uCD9C'\uC5D0 \uB2E4\uB2E4\uB790\uB294\uAC00?"
    m_Metadata:
      m_Items: []
  - m_Id: 1830526757822464
    m_Localized: "\uD604\uC7AC \uAE30\uB85D"
    m_Metadata:
      m_Items: []
  - m_Id: 1830526967537664
    m_Localized: "\uCD5C\uB2E8 \uAE30\uB85D"
    m_Metadata:
      m_Items: []
  - m_Id: 1830526967537665
    m_Localized: "\uAC8C\uC784 \uC7AC\uC2DC\uC791"
    m_Metadata:
      m_Items: []
  - m_Id: 2015269051195392
    m_Localized: "\uB178\uD2B8\uBD81 \uBCF4\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 2015269067972608
    m_Localized: "\uBA70\uCE60\uC9F8 \uBAB8 \uC0C1\uD0DC\uAC00 \uC601 \uC88B\uC9C0
      \uC54A\uB2E4.\n\n\uD0C8\uCD9C \uC0AC\uAC74 \uC774\uD6C4 \uAE34\uC7A5\uC774
      \uD55C\uAEBC\uBC88\uC5D0 \uD480\uB9B0 \uD0D3\uC778\uC9C0 <color=#C80000>\uAC10\uAE30\uC5D0
      \uAC78\uB9B0 \uAC83\uCC98\uB7FC \uC5F4\uC774 \uACC4\uC18D \uC624\uB978\uB2E4.</color>
      \uC758\uB8CC\uC9C4\uC740 \uBB34\uB9AC\uD574\uC11C \uBC84\uD2F0\uC9C0 \uB9D0\uACE0
      \uBCD1\uAC00\uB97C \uB0B4\uACE0 \uC26C\uB77C\uACE0 \uD588\uB2E4. \uB098\uB3C4
      \uCC98\uC74C\uC5D0\uB294 \uAD1C\uCC2E\uC744 \uC904 \uC54C\uC558\uB294\uB370
      \uBAB8\uC774 \uC0DD\uAC01\uBCF4\uB2E4 \uB9D0\uC744 \uB4E3\uC9C0 \uC54A\uB294\uB2E4.\n\n\uC5D0\uB7F0\uC740
      \uB0B4\uAC00 \uC26C\uACE0 \uC788\uC73C\uB2C8 \uAD1C\uD788 \uB354 \uBD88\uC548\uD55C
      \uC5BC\uAD74\uC774\uB2E4. \uADF8\uB798\uB3C4 \uC57D\uB3C4 \uCC59\uACA8\uC8FC\uACE0
      \uC2DD\uC0AC\uB3C4 \uAC00\uC838\uB2E4\uC8FC\uBA70 \uBB35\uBB35\uD788 \uACC1\uC744
      \uC9C0\uCF1C\uC92C\uB2E4. \uAC81\uC774 \uB9CE\uC740 \uC904\uB9CC \uC54C\uC558\uB294\uB370
      \uC758\uC678\uB85C \uCC38 \uCC29\uD55C \uB140\uC11D\uC774\uB2E4.\n\n\uCE68\uB300\uC5D0
      \uB204\uC6CC \uC788\uC73C\uB2C8 \uC790\uAFB8 \uC9D1 \uC0DD\uAC01\uC774 \uB09C\uB2E4.
      \uC5D8\uB808\uB098\uB294 \uC798 \uC9C0\uB0B4\uACE0 \uC788\uC744\uAE4C. \uC18C\uD53C\uC544\uC640
      \uB8E8\uCE74\uC2A4\uB3C4 \uC544\uBE60\uAC00 \uC5B8\uC81C \uC624\uB0D0\uACE0
      \uBB3C\uC5B4\uBCF4\uACE0 \uC788\uACA0\uC9C0. \uC774\uBC88 \uAC10\uAE30\uB9CC
      \uC5BC\uB978 \uD138\uC5B4\uB0B4\uACE0 \uB2E4\uC2DC \uC77C\uC5B4\uB098\uC57C\uACA0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2015269067972609
    m_Localized: "\uBA54\uC778 \uBAA9\uD45C"
    m_Metadata:
      m_Items: []
  - m_Id: 2015269067972610
    m_Localized: "\uC11C\uBE0C \uBAA9\uD45C"
    m_Metadata:
      m_Items: []
  - m_Id: 2015269067972611
    m_Localized: "\uC120\uC6D0\uC2E4 \uD0C8\uCD9C\uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 2015269067972612
    m_Localized: "\uC5D4\uC9C4\uC2E4\uC5D0\uC11C \uC804\uB825 \uBCF5\uAD6C\uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 2015269067972613
    m_Localized: "\uC5F0\uAD6C\uC2E4\uC5D0\uC11C \uC2EC\uD574\uC0DD\uBB3C DB \uD655\uC778\uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 2015269067972614
    m_Localized: "\uCC3D\uACE0\uC5D0\uC11C \uC0D8\uD50C \uAC00\uC838\uC624\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 2015269067972615
    m_Localized: "\uC5F0\uAD6C\uC2E4\uC5D0\uC11C \uCE58\uB8CC\uC81C \uC81C\uC870\uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 2015269067972616
    m_Localized: "\uC62C\uBC14\uB978 \uCE58\uB8CC\uC81C \uD22C\uC5EC\uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 2015269067972617
    m_Localized: "\uD0C8\uCD9C\uC2E4 \uD574\uCE58 \uC5F4\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 2015269067972618
    m_Localized: "\uBE45\uD130\uC758 \uC77C\uAE30\uC7A5 \uD68D\uB4DD\uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 2015269067972619
    m_Localized: "\uC120\uC6D0\uC2E4 1-4 \uBB38 \uC5F4\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 2015269067972620
    m_Localized: "\uC6D0\uACA9 \uACBD\uBCF4 \uC870\uC791\uD574\uBCF4\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 2015269067972621
    m_Localized: "\uC5B4\uB8B0 \uBC1C\uC0AC\uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 2015269067972622
    m_Localized: "\uC5B4\uB8B0 \uB808\uC774\uB354 \uC218\uB9AC\uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 2015269067972623
    m_Localized: "\uB9C8\uC9C0\uB9C9 \uC5B4\uB8B0 \uC218\uB3D9 \uC7A5\uC804\uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 2015269067972624
    m_Localized: "\uD0C8\uCD9C\uC2E4 \uBB38 \uC720\uC555 \uC218\uB3D9 \uBC38\uBE0C\uB85C
      \uC870\uC791\uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 2015269067972625
    m_Localized: "\uB2E8\uC11C \uB4F1\uB85D (\uB178\uD2B8\uC5D0\uC11C \uD655\uC778)"
    m_Metadata:
      m_Items: []
  - m_Id: 2015269067972626
    m_Localized: "\uD504\uB85C\uC81D\uD2B8 \uCF54\uB4DC\n\uBB38\uC11C \uBC88\uD638
      \n\uC791\uC131\uC77C\n\uC791\uC131 \uBD80\uC11C"
    m_Metadata:
      m_Items: []
  - m_Id: 2015269067972627
    m_Localized: "\u25A0 \uD504\uB85C\uC81D\uD2B8 \uBAA9\uC801\n\uAD6D\uAC00 \uC548\uBCF4
      \uBC0F \uAD70\uC0AC\uB825 \uC99D\uAC15\uC744 \uC704\uD574 \uC2EC\uD574\uC5D0\uC11C
      \uBC1C\uACAC\uB418\uB294\r \n\uBBF8\uD655\uC778 \uC0DD\uBB3C\uC758 \uC0DD\uBB3C\uD559\uC801
      \uD2B9\uC131\uC744 \uBD84\uC11D\uD558\uACE0 \uC774\uB97C \uC778\uAC04\uC5D0\uAC8C\r\n\uC801\uC6A9\uD558\uC5EC
      \uAE30\uC874 \uBCD1\uB825\uC744 \uB6F0\uC5B4\uB118\uB294 \uCC28\uC138\uB300
      \uC804\uD22C \uAC1C\uCCB4\uB97C\r\n\uAC1C\uBC1C\uD558\uB294 \uAC83\uC744 \uCD5C\uC885
      \uBAA9\uD45C\uB85C \uD55C\uB2E4.\r\n\r\n\uBCF8 \uD504\uB85C\uC81D\uD2B8\uB294
      \uAD6D\uAC00 \uCD5C\uC6B0\uC120 \uC804\uB7B5 \uC0AC\uC5C5\uC73C\uB85C \uC9C0\uC815\uB418\uBA70,\r\n\uBAA8\uB4E0
      \uC5F0\uAD6C \uB0B4\uC6A9\uC740 \uCD5C\uACE0 \uC218\uC900\uC758 \uAE30\uBC00\uB85C
      \uBD84\uB958\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2015269067972628
    m_Localized: "\u25A0 \uD504\uB85C\uC81D\uD2B8 \uAC1C\uC694\r\n\n\uC791\uC804\uBA85
      : ABYSS\r\n\n\uC2EC\uD574 \uC0DD\uBB3C\uC740 \uADF9\uD55C\uC758 \uC218\uC555\uACFC
      \uC800\uC628, \uC0B0\uC18C\uAC00 \uBD80\uC871\uD55C \uD658\uACBD\uC5D0\uC11C\uB3C4\r\n\uC0DD\uC874
      \uAC00\uB2A5\uD55C \uB3C5\uC790\uC801\uC778 \uC0DD\uBA85 \uAD6C\uC870\uB97C
      \uAC00\uC9C0\uACE0 \uC788\uB2E4.\r\n\n\uC5F0\uAD6C\uC9C4\uC740 \uD574\uB2F9
      \uC0DD\uBB3C\uC758 \uC870\uC9C1\uACFC \uC138\uD3EC\uB97C \uC774\uC6A9\uD558\uC5EC\r\n\uC778\uCCB4
      \uAC15\uD654 \uAE30\uC220\uC744 \uAC1C\uBC1C\uD558\uACE0, \uC774\uB97C \uAD70\uC0AC\uC801\uC73C\uB85C
      \uD65C\uC6A9\uD560 \uC218 \uC788\uB294\r\n\uC2E0\uD615 \uBCD1\uAE30\uC758 \uC81C\uC791
      \uAC00\uB2A5\uC131\uC744 \uAC80\uC99D\uD55C\uB2E4.\r\n\n\uBCF8 \uD504\uB85C\uC81D\uD2B8\uB294
      \uC2EC\uD574 \uC5F0\uAD6C \uC7A0\uC218\uD568 \uB0B4\uBD80\uC5D0 \uC124\uCE58\uB41C
      \uC5F0\uAD6C\uC2DC\uC124\uC5D0\uC11C \uC218\uD589\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2015269067972629
    m_Localized: "\u25A0 \uC2E4\uD5D8 \uB300\uC0C1 \uD655\uBCF4 \uACC4\uD68D\r\n\n\uC2E4\uD5D8
      \uB300\uC0C1 \uBD84\uB958 : C\uB4F1\uAE09\r\n\n\uB300\uC0C1 \uD655\uBCF4 \uBC29\uC2DD\r\n\u25A1
      \uC2E0\uC6D0 \uBBF8\uD655\uC778 \uC778\uC6D0\r\n\u25A1 \uC2E4\uC885 \uCC98\uB9AC
      \uC608\uC815 \uBBFC\uAC04\uC778\r\n\u25A1 \uBE44\uACF5\uAC1C \uC774\uC1A1 \uB300\uC0C1\r\n\u25A1
      \uAE30\uD0C0 \uC2B9\uC778 \uB300\uC0C1\r\n\n\uBAA8\uB4E0 \uB300\uC0C1\uC790\uB294
      \uC5F0\uAD6C \uC2DC\uC124 \uB3C4\uCC29 \uC989\uC2DC \uAD00\uB9AC \uB300\uC0C1\uC73C\uB85C\r\n\uC804\uD658\uD558\uBA70,
      \uD504\uB85C\uC81D\uD2B8 \uC885\uB8CC \uC804\uAE4C\uC9C0 \uC678\uBD80\uC640\uC758
      \uC811\uCD09\uC744\r\n\uC804\uBA74 \uCC28\uB2E8\uD55C\uB2E4.\r\n\n\uB300\uC0C1\uC790\uC758
      \uC0DD\uC874 \uC5EC\uBD80\uB294 \uC5F0\uAD6C \uBAA9\uC801\uC5D0 \uC6B0\uC120\uD558\uC9C0
      \uC54A\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2015269067972630
    m_Localized: ": ABYSS\n: ABYSS-PRE-001\n: 2003\uB144 09\uC6D4 04\uC77C\n: \uD2B9\uC218
      \uC2EC\uD574 \uC5F0\uAD6C\uBCF8\uBD80"
    m_Metadata:
      m_Items: []
  - m_Id: 2185715243573248
    m_Localized: "\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\n\n                       
      \u2588\u2588\u2588 1\uAE09 \uAD70\uC0AC\uAE30\uBC00 \u2588\u2588\u2588\n\n\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\n\n\uD504\uB85C\uC81D\uD2B8
      \uCF54\uB4DC      : ABYSS\n\uBB38\uC11C \uBC88\uD638          : ABYSS-PRE-001\n\uBB38\uC11C
      \uB4F1\uAE09          : \uCD5C\uACE0 \uAE30\uBC00\n\uC791\uC131\uC77C            
      : 2003\uB144 09\uC6D4 04\uC77C\n\uC791\uC131 \uBD80\uC11C          : \uD2B9\uC218
      \uC2EC\uD574 \uC5F0\uAD6C\uBCF8\uBD80\n\n\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\n\n                    
      \u300CPROJECT ABYSS\u300D\n\n            \uC2EC\uD574 \uC0DD\uBB3C \uD65C\uC6A9
      \uCC28\uC138\uB300 \uBCD1\uAE30 \uAC1C\uBC1C \uACC4\uD68D\n\n\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\n\n\u25A0
      \uD504\uB85C\uC81D\uD2B8 \uBAA9\uC801\n\n\uAD6D\uAC00 \uC548\uBCF4 \uBC0F \uAD70\uC0AC\uB825
      \uC99D\uAC15\uC744 \uC704\uD574 \uC2EC\uD574\uC5D0\uC11C \uBC1C\uACAC\uB418\uB294\n\uBBF8\uD655\uC778
      \uC0DD\uBB3C\uC758 \uC0DD\uBB3C\uD559\uC801 \uD2B9\uC131\uC744 \uBD84\uC11D\uD558\uACE0
      \uC774\uB97C \uC778\uAC04\uC5D0\uAC8C\n\uC801\uC6A9\uD558\uC5EC \uAE30\uC874
      \uBCD1\uB825\uC744 \uB6F0\uC5B4\uB118\uB294 \uCC28\uC138\uB300 \uC804\uD22C
      \uAC1C\uCCB4\uB97C\n\uAC1C\uBC1C\uD558\uB294 \uAC83\uC744 \uCD5C\uC885 \uBAA9\uD45C\uB85C
      \uD55C\uB2E4.\n\n\uBCF8 \uD504\uB85C\uC81D\uD2B8\uB294 \uAD6D\uAC00 \uCD5C\uC6B0\uC120
      \uC804\uB7B5 \uC0AC\uC5C5\uC73C\uB85C \uC9C0\uC815\uB418\uBA70,\n\uBAA8\uB4E0
      \uC5F0\uAD6C \uB0B4\uC6A9\uC740 \uCD5C\uACE0 \uC218\uC900\uC758 \uAE30\uBC00\uB85C
      \uBD84\uB958\uD55C\uB2E4.\n\n\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\n\n\u25A0
      \uD504\uB85C\uC81D\uD2B8 \uAC1C\uC694\n\n\uC791\uC804\uBA85 : ABYSS\n\n\uC2EC\uD574
      \uC0DD\uBB3C\uC740 \uADF9\uD55C\uC758 \uC218\uC555\uACFC \uC800\uC628, \uC0B0\uC18C\uAC00
      \uBD80\uC871\uD55C \uD658\uACBD\uC5D0\uC11C\uB3C4\n\uC0DD\uC874 \uAC00\uB2A5\uD55C
      \uB3C5\uC790\uC801\uC778 \uC0DD\uBA85 \uAD6C\uC870\uB97C \uAC00\uC9C0\uACE0
      \uC788\uB2E4.\n\n\uC5F0\uAD6C\uC9C4\uC740 \uD574\uB2F9 \uC0DD\uBB3C\uC758 \uC870\uC9C1\uACFC
      \uC138\uD3EC\uB97C \uC774\uC6A9\uD558\uC5EC\n\uC778\uCCB4 \uAC15\uD654 \uAE30\uC220\uC744
      \uAC1C\uBC1C\uD558\uACE0, \uC774\uB97C \uAD70\uC0AC\uC801\uC73C\uB85C \uD65C\uC6A9\uD560
      \uC218 \uC788\uB294\n\uC2E0\uD615 \uBCD1\uAE30\uC758 \uC81C\uC791 \uAC00\uB2A5\uC131\uC744
      \uAC80\uC99D\uD55C\uB2E4.\n\n\uBCF8 \uD504\uB85C\uC81D\uD2B8\uB294 \uC2EC\uD574
      \uC5F0\uAD6C \uC7A0\uC218\uD568 \uB0B4\uBD80\uC5D0 \uC124\uCE58\uB41C \uC5F0\uAD6C\uC2DC\uC124\uC5D0\uC11C
      \uC218\uD589\uD55C\uB2E4.\n\n\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\n\n\u25A0
      \uC2E4\uD5D8 \uB300\uC0C1 \uD655\uBCF4 \uACC4\uD68D\n\n\uC2E4\uD5D8 \uB300\uC0C1
      \uBD84\uB958 : C\uB4F1\uAE09\n\n\uB300\uC0C1 \uD655\uBCF4 \uBC29\uC2DD\n\n\u25A1
      \uC2E0\uC6D0 \uBBF8\uD655\uC778 \uC778\uC6D0\n\u25A1 \uC2E4\uC885 \uCC98\uB9AC
      \uC608\uC815 \uBBFC\uAC04\uC778\n\u25A1 \uBE44\uACF5\uAC1C \uC774\uC1A1 \uB300\uC0C1\n\u25A1
      \uAE30\uD0C0 \uC2B9\uC778 \uB300\uC0C1\n\n\uBAA8\uB4E0 \uB300\uC0C1\uC790\uB294
      \uC5F0\uAD6C \uC2DC\uC124 \uB3C4\uCC29 \uC989\uC2DC \uAD00\uB9AC \uB300\uC0C1\uC73C\uB85C\n\uC804\uD658\uD558\uBA70,
      \uD504\uB85C\uC81D\uD2B8 \uC885\uB8CC \uC804\uAE4C\uC9C0 \uC678\uBD80\uC640\uC758
      \uC811\uCD09\uC744\n\uC804\uBA74 \uCC28\uB2E8\uD55C\uB2E4.\n\n\uB300\uC0C1\uC790\uC758
      \uC0DD\uC874 \uC5EC\uBD80\uB294 \uC5F0\uAD6C \uBAA9\uC801\uC5D0 \uC6B0\uC120\uD558\uC9C0
      \uC54A\uB294\uB2E4."
