  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\n<b>[ \uAD00\uCC30 \uB370\uC774\uD130 ]</b>\n\uD2B9\uC815 \uC0D8\uD50C
    \uD63C\uD569 \uC774\uD6C4 \uD604\uBBF8\uACBD \uC2DC\uC57C \uB0B4\uC5D0\uC11C
    <color=#FFCC00><b>\uC120\uBA85\uD55C \uCCAD\uC0C9 \uACB0\uC815\uCCB4\uAC00 \uC721\uAC01\uD615
    \uC0AC\uC2AC \uD615\uD0DC\uB85C \uC5F0\uACB0</b></color>\uB418\uB294 \uD604\uC0C1\uC774
    \uAD00\uCC30\uB418\uC5C8\uB2E4.\n\uD574\uB2F9 \uAD6C\uC870\uB294 \uC77C\uC815
    \uC2DC\uAC04 \uB3D9\uC548 \uC548\uC815\uC801\uC73C\uB85C \uC720\uC9C0\uB418\uBA70,
    \uC138\uD3EC \uC870\uC9C1 \uC8FC\uBCC0 \uBC18\uC751 \uC18D\uB3C4\uB97C \uAC10\uC18C\uC2DC\uD0A4\uB294
    \uD2B9\uC131\uC744 \uBCF4\uC778\uB2E4.\n\n<b>[ \uCD94\uAC00 \uBC18\uC751 ]</b>\n\uC77C\uBD80
    \uC0D8\uD50C\uC5D0\uC11C\uB294 <color=#FFCC00><b>\uACB0\uC815 \uC0AC\uC2AC \uC8FC\uBCC0\uC73C\uB85C
    \uBD89\uC740 \uC138\uD3EC \uC870\uC9C1\uC774 \uBD80\uCC29</b></color>\uB418\uB294
    \uD604\uC0C1\uC774 \uD655\uC778\uB418\uC5C8\uB2E4.\n\uBD89\uC740 \uC138\uD3EC\uAC00
    \uACB0\uD569\uB41C \uAD6C\uC870\uB294 \uC0C1\uB300\uC801\uC73C\uB85C \uBD95\uAD34
    \uC18D\uB3C4\uAC00 \uB290\uB838\uC73C\uBA70, \uC870\uC9C1 \uBCC0\uC0C9 \uBC18\uC751
    \uB610\uD55C \uAC10\uC18C\uD55C\uB2E4.\n\uBC18\uB300\uB85C \uBD89\uC740 \uC138\uD3EC\uAC00
    \uC874\uC7AC\uD558\uC9C0 \uC54A\uB294 \uAD6C\uC870\uB294 \uC77C\uC815 \uC2DC\uAC04
    \uC774\uD6C4 \uBE60\uB974\uAC8C \uADE0\uC5F4\uB418\uAE30 \uC2DC\uC791\uD588\uB2E4.\n\n<b>[
    \uC624\uC5FC \uBC18\uC751 ]</b>\n\uBD88\uC644\uC804 \uC0D8\uD50C\uC5D0\uC11C\uB294
    <color=#FFCC00><b>\uAC80\uC740\uC0C9 \uD30C\uD3B8 \uAD6C\uC870</b></color>\uAC00
    \uAD00\uCC30\uB418\uC5C8\uB2E4.\n\uC624\uC5FC \uBC18\uC751 \uBC1C\uC0DD \uC774\uD6C4
    \uCCAD\uC0C9 \uACB0\uC815 \uAD6C\uC870\uB294 \uAE09\uC18D\uD788 \uBD95\uAD34\uB418\uC5C8\uC73C\uBA70,
    \uC77C\uBD80 \uC0D8\uD50C\uC740 \uAC80\uC740\uC0C9\uC73C\uB85C \uBCC0\uC9C8\uB418\uC5C8\uB2E4.\n\n"
