      m_Calls: []
  m_text: "\u25A0 Project Overview\n\nOperation Name: ABYSS\n\nDeep-sea creatures
    have their own life structures that can survive even in extreme water pressure,
    low temperatures, and oxygen-deficient environments.\n\nThe researchers develop
    human-strengthening technology using tissues and cells of the organism and verify
    the possibility of manufacturing new weapons that can be used militarily.\n\nThis
    project is carried out at a research facility installed inside a deep-sea research
    submarine."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 5a6117b9c91289743a39dc4ed521d00a, type: 2}
  m_sharedMaterial: {fileID: -440651621371215574, guid: 5a6117b9c91289743a39dc4ed521d00a,
    type: 2}
