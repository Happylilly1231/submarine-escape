--- !u!114 &6140649248793134969
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1844437231862598180}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 92daebf38d50a6a48b5152ab4201f51c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  leftPanel: {fileID: 8038039502353864686}
  rightPanel: {fileID: 595918302299624742}
  prevButton: {fileID: 2044417660452474909}
  nextButton: {fileID: 6135219584340835016}
  diaryEntries:
  - date: 02/15
    content: "\uC624\uB298\uBD80\uD130 <color=#C80000>\uC2EC\uD574 \uC0DD\uBB3C \uD0D0\uC0AC
      \uC784\uBB34</color>\uC5D0 \uD22C\uC785\uB41C\uB2E4. \n\uCD9C\uD56D \uC804
      \uBD80\uB450\uC5D0\uB294 \uC5D8\uB808\uB098\uC640 \uC18C\uD53C\uC544, \uB8E8\uCE74\uC2A4\uAC00
      \uB098\uC640 \uBC30\uC6C5\uD574 \uC8FC\uC5C8\uB2E4. \uBC84\uB514\uB791 \uCC30\uB9AC\uB3C4
      \uC2E0\uB098\uAC8C \uB6F0\uC5B4\uB2E4\uB2C8\uBA70 \uB098\uB97C \uBC18\uACA8\uC92C\uB2E4.
      \uB5A0\uB098\uB294 \uC21C\uAC04\uAE4C\uC9C0\uB3C4 \uC544\uC774\uB4E4\uC740
      \uC6C3\uACE0 \uC788\uC5C8\uC9C0\uB9CC, \uC5D8\uB808\uB098\uB294 \uC560\uC368
      \uAC71\uC815\uC744 \uC228\uAE30\uACE0 \uC788\uB294 \uAC8C \uB208\uC5D0 \uBCF4\uC600\uB2E4.\n\uC7A0\uC218\uD568\uC5D0
      \uB3C4\uCC29\uD558\uC790\uB9C8\uC790 \uBC30\uC815\uBC1B\uC740 \uBC29\uC744
      \uC815\uB9AC\uD588\uB2E4. \uB77C\uCEE4 \uBB38 \uC548\uCABD\uC5D0\uB294 \uC18C\uD53C\uC544\uAC00
      \uADF8\uB824\uC900 \uAC00\uC871 \uADF8\uB9BC\uACFC \uBC84\uB514, \uCC30\uB9AC
      \uC0AC\uC9C4\uC744 \uBD99\uC5EC\uB450\uC5C8\uB2E4. \uB77C\uCEE4\uB97C \uC5F4
      \uB54C\uB9C8\uB2E4 \uAC00\uC871 \uC5BC\uAD74\uC744 \uBCFC \uC218 \uC788\uC73C\uB2C8
      \uC870\uAE08\uC740 \uBC84\uD2F8 \uD798\uC774 \uB0A0 \uAC83 \uAC19\uB2E4. \uAC00\uC871\uC744
      \uB450\uACE0 \uC2EC\uD574\uB85C \uB4E4\uC5B4\uAC00\uB294 \uAC74 \uC5EC\uC804\uD788
      \uC27D\uC9C0 \uC54A\uB2E4. \uADF8\uB798\uB3C4 \uC544\uC9C1 \uC138\uC0C1\uC5D0
      \uC54C\uB824\uC9C0\uC9C0 \uC54A\uC740 \uC2EC\uD574 \uC0DD\uBB3C\uC744 \uC9C1\uC811
      \uD0D0\uC0C9\uD558\uACE0 \uD3EC\uD68D\uD560 \uC218 \uC788\uB2E4\uB294 \uC0DD\uAC01\uC5D0
      \uB9C8\uC74C \uD55C\uD3B8\uC774 \uC124\uB80C\uB2E4. \n\uC6B0\uB9AC\uAC00 \uD655\uBCF4\uD55C
      \uC0DD\uBB3C\uB4E4\uC740 \uC5F0\uAD6C\uC6D0\uB4E4\uC5D0\uAC8C \uC804\uB2EC\uB418\uACE0,
      \uADF8 \uC5F0\uAD6C\uAC00 \uC5B8\uC820\uAC00\uB294 \uC0C8\uB85C\uC6B4 \uCE58\uB8CC\uC81C\uB098
      \uAE30\uC220 \uAC1C\uBC1C\uB85C \uC774\uC5B4\uC838 \uB9CE\uC740 \uC0AC\uB78C\uB4E4\uC5D0\uAC8C
      \uB3C4\uC6C0\uC774 \uB420\uC9C0\uB3C4 \uBAA8\uB978\uB2E4. \uC704\uD5D8\uD55C
      \uC784\uBB34\uC9C0\uB9CC \uADF8\uB9CC\uD55C \uAC00\uCE58\uAC00 \uC788\uB2E4\uACE0
      \uBBFF\uB294\uB2E4. \uC774\uBC88 \uC784\uBB34\uB3C4 \uBAA8\uB450 \uBB34\uC0AC\uD788
      \uB9C8\uCE58\uACE0 \uAC00\uC871 \uACC1\uC73C\uB85C \uB3CC\uC544\uAC00\uC57C\uACA0\uB2E4.\n\uB8F8\uBA54\uC774\uD2B8\uB294
      \uB0B4 \uBD80\uD558\uC778 \uC5D0\uB7F0 \uB2E4\uC774\uC5B4\uB2E4. \uD0D1\uC2B9\uD558\uB294
      \uB0B4\uB0B4 \uAE34\uC7A5\uD55C \uD45C\uC815\uC774\uC5C8\uB2E4. \uC2EC\uD574
      \uC0DD\uBB3C\uC744 \uC2E4\uC81C\uB85C \uBCF4\uB294 \uAC74 \uCC98\uC74C\uC774\uB77C\uB294\uB370,
      \uC774\uB807\uAC8C \uAC81\uC774 \uB9CE\uC544\uC11C\uC57C \uD3EC\uD68D \uC784\uBB34\uB97C
      \uC81C\uB300\uB85C \uD560 \uC218 \uC788\uC744\uC9C0 \uBAA8\uB974\uACA0\uB2E4.
      \uADF8\uB798\uB3C4 \uACBD\uD5D8\uC744 \uC313\uB2E4 \uBCF4\uBA74 \uC870\uAE08\uC529
      \uB098\uC544\uC9C0\uACA0\uC9C0."
  - date: 02/17
    content: "\uC624\uB298\uC740 \uCCAB \uC21C\uCC30\uACFC \uC7A5\uBE44 \uC810\uAC80\uC744
      \uD588\uB2E4.\n\r\n\uC5F0\uAD6C\uC6D0\uB4E4\uC740 \uD558\uB8E8 \uC885\uC77C
      \uC0C8\uB85C\uC6B4 \uC2EC\uD574 \uC0DD\uBB3C \uD45C\uBCF8\uC744 \uBD84\uC11D\uD558\uB290\uB77C
      \uC815\uC2E0\uC774 \uC5C6\uC5C8\uB2E4. \uC6B0\uB9AC \uC785\uC7A5\uC5D0\uC11C\uB294
      \uC704\uD5D8\uD55C \uC0DD\uBB3C\uC774\uC9C0\uB9CC, \uC5F0\uAD6C\uC6D0\uB4E4
      \uB208\uC5D0\uB294 \uADC0\uC911\uD55C \uC5F0\uAD6C \uC790\uB8CC\uC778 \uBAA8\uC591\uC774\uB2E4.\n\r\n\uC2DD\uB2F9\uC5D0\uC11C
      \uD074\uB85C\uC774 \uB808\uC774\uB180\uC988\uC640 \uC7A0\uAE50 \uC774\uC57C\uAE30\uB97C
      \uB098\uB234\uB2E4. \uC5F0\uAD6C \uC598\uAE30\uB97C \uC2DC\uC791\uD558\uBA74
      \uC2DC\uAC04 \uAC00\uB294 \uC904 \uBAA8\uB974\uB294 \uC0AC\uB78C\uC774\uB2E4.\n\r\n\uC5D0\uB7F0\uC740
      \uC5EC\uC804\uD788 \uC5F0\uAD6C\uC2E4 \uADFC\uCC98\uB97C \uC9C0\uB098\uAC08
      \uB54C\uB9C8\uB2E4 \uC794\uB729 \uAE34\uC7A5\uD55C\uB2E4."
  - date: 02/19
    content: "\uC624\uB298\uC740 <color=#C80000>\uB85C\uBC84\uD2B8 \uD5E4\uC774\uC988
      \uC9C0\uD718\uAD00\uB2D8</color>\uC758 \uC0DD\uC2E0\uC774\uC5C8\uB2E4.\n\r\n\uD3C9\uC18C\uC5D0\uB294
      \uC791\uC740 \uC2E4\uC218\uB3C4 \uADF8\uB0E5 \uB118\uAE30\uC9C0 \uC54A\uC73C\uC2E4
      \uB9CC\uD07C \uC5C4\uACA9\uD55C \uBD84\uC774\uC9C0\uB9CC, \uB300\uC6D0\uB4E4\uC774
      \uC900\uBE44\uD55C \uC791\uC740 \uCD95\uD558 \uC790\uB9AC\uC5D0\uC11C\uB294
      \uB4DC\uBB3C\uAC8C \uBBF8\uC18C\uB97C \uBCF4\uC5EC\uC8FC\uC168\uB2E4. \uC7A0\uC218\uD568
      \uC548 \uBD84\uC704\uAE30\uB3C4 \uC624\uB79C\uB9CC\uC5D0 \uBC1D\uC544\uC84C\uB2E4."
  - date: 02/22
    content: "\uC624\uB298\uC740 \uC7A0\uC218\uD568 \uBC16\uC73C\uB85C \uB098\uAC00
      \uC0C8\uB85C\uC6B4 \uC2EC\uD574 \uC0DD\uBB3C \uD0D0\uC0AC\uB97C \uC9C4\uD589\uD588\uB2E4.\n\n\uC5B8\uC81C
      \uD574\uB3C4 <color=#C80000>\uD0C8\uCD9C\uC2E4</color>\uC5D0 \uB4E4\uC5B4\uAC00\uB294
      \uC21C\uAC04\uC740 \uAE34\uC7A5\uB41C\uB2E4. <color=#C80000>\uB0B4\uBD80 \uD574\uCE58\uB97C
      \uB2EB\uACE0</color> \uD574\uC218\uAC00 \uCC9C\uCC9C\uD788 \uCC28\uC624\uB97C
      \uB54C\uBA74 \uC228\uC774 \uD131 \uB9C9\uD788\uB294 \uAE30\uBD84\uC774\uB2E4.
      \uCC98\uC74C \uC774 \uC784\uBB34\uB97C \uB9E1\uC558\uC744 \uB54C\uB294 \uBB3C\uC774
      \uBAA9\uAE4C\uC9C0 \uCC28\uC624\uB974\uB294 \uAC83\uB9CC\uC73C\uB85C\uB3C4
      \uC2DD\uC740\uB540\uC774 \uB0AC\uC5C8\uB2E4.\n\n\uD558\uC9C0\uB9CC \uC9C4\uC9DC
      \uC911\uC694\uD55C \uAC74 \uADF8\uB2E4\uC74C\uC774\uB2E4. \uC678\uBD80 \uD574\uC218\uAC00
      \uBAA8\uB450 \uCC28\uBA74 \uC11C\uB450\uB974\uC9C0 \uB9D0\uACE0 <color=#C80000>\uC555\uB825\uC744
      \uBA3C\uC800 \uB9DE\uCDB0\uC57C \uD55C\uB2E4.</color> \uAE4A\uC740 \uBC14\uB2E4\uC5D0\uC11C\uB294
      \uC218\uC555\uC774 \uC21C\uC2DD\uAC04\uC5D0 \uBAB8\uC744 \uC9D3\uB204\uB974\uAE30
      \uB54C\uBB38\uC5D0 \uC774 \uACFC\uC815\uC744 \uAC74\uB108\uB6F0\uBA74 \uADC0\uAC00
      \uCC22\uC5B4\uC9C8 \uB4EF\uD55C \uD1B5\uC99D\uC774 \uCC3E\uC544\uC628\uB2E4.\n\n\uB098\uB294
      \uD56D\uC0C1 \uCF54\uB97C \uB9C9\uACE0 \uCC9C\uCC9C\uD788 \uC228\uC744 \uBC00\uC5B4
      \uB123\uC5B4 \uADC0 \uC548\uCABD \uC555\uB825\uC744 \uB9DE\uCD98 \uB4A4 \uBC16\uC73C\uB85C
      \uB098\uAC04\uB2E4. \uBAB8\uC774 \uAD1C\uCC2E\uB2E4\uACE0 \uB290\uAEF4\uC9C8
      \uB54C\uAE4C\uC9C0 \uBA87 \uBC88\uC774\uACE0 \uBC18\uBCF5\uD558\uB294 \uAC8C
      \uC694\uB839\uC774\uB2E4. \uAE09\uD558\uAC8C \uB098\uAC00\uB824\uB2E4 \uACE0\uC0DD\uD558\uB294
      \uC2E0\uC785\uB4E4\uC744 \uC5EC\uB7FF \uBD24\uB2E4.\n\n\uC624\uB298\uB3C4 \uC5D0\uB7F0\uC740
      \uAE34\uC7A5\uD55C \uB098\uBA38\uC9C0 \uC555\uB825 \uD3C9\uD615\uC744 \uC81C\uB300\uB85C
      \uB9DE\uCD94\uC9C0 \uBABB\uD574 \uADC0\uB97C \uBD99\uC7A1\uACE0 \uD55C\uCC38\uC744
      \uC778\uC0C1\uC744 \uCC0C\uD478\uB838\uB2E4. \uB140\uC11D\uC5D0\uAC8C\uB294
      \uBA87 \uBC88\uC774\uACE0 \uB9D0\uD588\uC9C0\uB9CC, \uC2EC\uD574\uC5D0\uC11C\uB294
      \uC11C\uB450\uB974\uB294 \uAC83\uBCF4\uB2E4 \uC808\uCC28\uB97C \uC9C0\uD0A4\uB294
      \uAC83\uC774 \uBAA9\uC228\uC744 \uC9C0\uD0A4\uB294 \uC77C\uC774\uB2E4.\n\n\uD0D0\uC0AC\uB294
      \uBB34\uC0AC\uD788 \uB05D\uB0AC\uACE0, \uCC98\uC74C \uBCF4\uB294 \uC2EC\uD574
      \uC0DD\uBB3C\uB3C4 \uD55C \uB9C8\uB9AC \uD655\uBCF4\uD588\uB2E4. \uC704\uD5D8\uC740
      \uB530\uB974\uC9C0\uB9CC \uC544\uC9C1 \uC138\uC0C1\uC5D0 \uC54C\uB824\uC9C0\uC9C0
      \uC54A\uC740 \uC0DD\uBB3C\uC744 \uC9C1\uC811 \uBC1C\uACAC\uD558\uB294 \uC21C\uAC04\uB9CC\uD07C\uC740
      \uC5B8\uC81C\uB098 \uAC00\uC2B4\uC774 \uB6F4\uB2E4."
  - date: 02/27
    content: "\uADFC\uBB34\uB97C \uB9C8\uCE5C \uB4A4 \uC624\uB79C\uB9CC\uC5D0 \uC6B4\uB3D9\uC744
      \uD588\uB2E4. \uD3EC\uD68D \uC791\uC5C5\uC740 \uC0DD\uAC01\uBCF4\uB2E4 \uCCB4\uB825\uC744
      \uB9CE\uC774 \uC4F0\uAE30 \uB54C\uBB38\uC5D0 \uBAB8 \uAD00\uB9AC\uB294 \uD544\uC218\uB2E4.\r\n\r\n\uC800\uB141\uC5D0\uB294
      \uB300\uC6D0\uB4E4\uACFC \uCE74\uB4DC \uAC8C\uC784\uC744 \uD588\uB2E4. \uC5D0\uB7F0\uB3C4
      \uCC98\uC74C\uC5D4 \uBA40\uB6B1\uD788 \uBCF4\uACE0\uB9CC \uC788\uB2E4\uAC00
      \uACB0\uAD6D \uB07C\uC5B4\uB4E4\uC5C8\uB294\uB370, \uC0DD\uAC01\uBCF4\uB2E4
      \uC2B9\uBD80\uC695\uC774 \uAC15\uD574\uC11C \uB2E4\uB4E4 \uC6C3\uC5C8\uB2E4.\r\n\r\n\uAD1C\uD788
      \uD53C\uACE4\uD588\uB358 \uD558\uB8E8\uAC00 \uC870\uAE08\uC740 \uAC00\uBCBC\uC6CC\uC84C\uB2E4."
  - date: 03/01
    content: "\uC624\uB298\uB3C4 \uD0D0\uC0AC\uB294 \uC21C\uC870\uB85C\uC6E0\uB2E4.\r\n\r\n\uBA70\uCE60
      \uC804 \uD3EC\uD68D\uD588\uB358 \uC2EC\uD574 \uC0DD\uBB3C\uC744 \uC5F0\uAD6C\uD558\uB358
      \uD074\uB85C\uC774\uAC00 \uB4E4\uB72C \uD45C\uC815\uC73C\uB85C \uC0C8\uB85C\uC6B4
      \uC5F0\uAD6C \uACB0\uACFC\uB97C \uC124\uBA85\uD574 \uC8FC\uC5C8\uB2E4. \uC790\uAC00
      \uC7AC\uC0DD\uC744 \uC720\uB3C4\uD558\uB294 \uD608\uCCAD\uC744 \uCD94\uCD9C\uD558\uB294
      \uB370 \uC131\uACF5\uD588\uB2E4\uACE0 \uD55C\uB2E4. \uC544\uC9C1 \uC5F0\uAD6C
      \uB2E8\uACC4\uC9C0\uB9CC \uC5B8\uC820\uAC00\uB294 \uB9CE\uC740 \uC0AC\uB78C\uC744
      \uC0B4\uB9B4 \uC218\uB3C4 \uC788\uB2E4\uBA70 \uBB34\uCC99 \uAE30\uBED0\uD588\uB2E4.\r\n\r\n\uADF8
      \uC774\uC57C\uAE30\uB97C \uB4E3\uACE0 \uC788\uC73C\uB2C8 \uC704\uD5D8\uC744
      \uBB34\uB985\uC4F0\uACE0 \uC2EC\uD574\uAE4C\uC9C0 \uB0B4\uB824\uC624\uB294
      \uC774\uC720\uB97C \uC870\uAE08\uC740 \uC54C \uAC83 \uAC19\uC558\uB2E4."
  - date: 03/05
    content: "<color=#C80000>\uB2E4\uB2C8\uC5D8 \uBCF4\uC774\uB4DC \uC7A5\uAD50\uB2D8</color>\uC758
      \uC0DD\uC77C\uC774 \uB0B4\uC77C\uC774\uB2E4.\r\n\r\n\uD56D\uC0C1 \uB300\uC6D0\uB4E4\uBD80\uD130
      \uCC59\uAE30\uB294 \uBD84\uC774\uB77C \uB2E4\uB4E4 \uC791\uC740 \uC120\uBB3C\uC744
      \uC900\uBE44\uD558\uACE0 \uC788\uB2E4. \uC774\uB7F0 \uD3D0\uC1C4\uB41C \uACF5\uAC04\uC5D0\uC11C\uB294
      \uC0AC\uC18C\uD55C \uC774\uBCA4\uD2B8 \uD558\uB098\uAC00 \uBD84\uC704\uAE30\uB97C
      \uAF64 \uBC14\uAFD4\uC900\uB2E4.\r\n\r\n\uC5D0\uB7F0\uB3C4 \uC7A5\uAD50\uB2D8\uAED8
      \uBB58 \uB4DC\uB9B4\uC9C0 \uC9C4\uC9C0\uD558\uAC8C \uACE0\uBBFC\uD558\uB294
      \uAC78 \uBCF4\uB2C8 \uC5B4\uB290 \uC815\uB3C4\uB294 \uC801\uC751\uD55C \uBAA8\uC591\uC774\uB2E4.
      \uCC98\uC74C \uD0D1\uC2B9\uD588\uC744 \uB54C\uBCF4\uB2E4\uB294 \uC5BC\uAD74\uC5D0
      \uC5EC\uC720\uAC00 \uC0DD\uACBC\uB2E4."
  - date: 03/12
    content: "\uC624\uB298\uC740 \uD3C9\uC0DD \uC78A\uC9C0 \uBABB\uD560 \uB0A0\uC774
      \uB420 \uAC83 \uAC19\uB2E4.\r\n\r\n\uC5F0\uAD6C \uC911\uC774\uB358 \uC2EC\uD574
      \uC0DD\uBB3C \uD558\uB098\uAC00 \uAC11\uC790\uAE30 \uACA9\uB9AC \uAD6C\uC5ED\uC744
      \uB6AB\uACE0 \uD0C8\uCD9C\uD588\uB2E4. \uACBD\uBCF4\uAC00 \uC6B8\uB9AC\uC790\uB9C8\uC790
      \uACBD\uBE44 \uBD80\uB300\uB97C \uC774\uB04C\uACE0 \uD604\uC7A5\uC73C\uB85C
      \uB6F0\uC5B4\uAC14\uB2E4.\r\n\r\n\uB140\uC11D\uC740 \uB4F1\uC5D0 \uB3CB\uC740
      <color=#C80000>\uB0A0\uCE74\uB85C\uC6B4 \uAC00\uC2DC</color>\uB97C \uC0AC\uBC29\uC73C\uB85C
      \uC3D8\uC544\uB300\uBA70 \uBBF8\uCE5C \uB4EF\uC774 \uB0A0\uB6F0\uC5C8\uB2E4.
      \uAC00\uAE4C\uC2A4\uB85C \uC81C\uC555\uD558\uAE34 \uD588\uC9C0\uB9CC \uAE34\uC7A5\uAC10
      \uB54C\uBB38\uC5D0 \uC544\uC9C1\uB3C4 \uC190\uB05D\uC774 \uB5A8\uB9AC\uB294
      \uAE30\uBD84\uC774\uB2E4.\r\n\r\n\uBB34\uC5C7\uBCF4\uB2E4 \uACC4\uC18D \uBA38\uB9BF\uC18D\uC744
      \uB5A0\uB098\uC9C0 \uC54A\uB294 \uAC74 \uB140\uC11D\uC758 \uBAA8\uC2B5\uC774\uB2E4.
      \uCCB4\uD615\uB3C4 \uADF8\uB807\uACE0 \uC6C0\uC9C1\uC774\uB294 \uBC29\uC2DD\uB3C4
      <color=#C80000>\uC0AC\uB78C</color>\uACFC \uB108\uBB34 \uB2EE\uC544 \uC788\uC5C8\uB2E4.
      \uB208\uC774 \uB9C8\uC8FC\uCE5C \uC21C\uAC04 \uB4F1\uACE8\uC774 \uC11C\uB298\uD574\uC84C\uB2E4.
      \uB2E8\uC21C\uD55C \uC2EC\uD574 \uC0DD\uBB3C\uC774\uB77C\uACE0 \uD558\uAE30\uC5D4
      \uB108\uBB34 \uAE30\uAD34\uD588\uB2E4.\r\n\r\n\uC624\uB298\uC740 \uC27D\uAC8C
      \uC7A0\uB4E4 \uC218 \uC788\uC744 \uAC83 \uAC19\uC9C0 \uC54A\uB2E4."
  - date: 03/16
    content: "\uBA70\uCE60\uC9F8 \uBAB8 \uC0C1\uD0DC\uAC00 \uC601 \uC88B\uC9C0 \uC54A\uB2E4.\n\n\uD0C8\uCD9C
      \uC0AC\uAC74 \uC774\uD6C4 \uAE34\uC7A5\uC774 \uD55C\uAEBC\uBC88\uC5D0 \uD480\uB9B0
      \uD0D3\uC778\uC9C0 <color=#C80000>\uAC10\uAE30\uC5D0 \uAC78\uB9B0 \uAC83\uCC98\uB7FC
      \uC5F4\uC774 \uACC4\uC18D \uC624\uB978\uB2E4.</color> \uC758\uB8CC\uC9C4\uC740
      \uBB34\uB9AC\uD574\uC11C \uBC84\uD2F0\uC9C0 \uB9D0\uACE0 \uBCD1\uAC00\uB97C
      \uB0B4\uACE0 \uC26C\uB77C\uACE0 \uD588\uB2E4. \uB098\uB3C4 \uCC98\uC74C\uC5D0\uB294
      \uAD1C\uCC2E\uC744 \uC904 \uC54C\uC558\uB294\uB370 \uBAB8\uC774 \uC0DD\uAC01\uBCF4\uB2E4
      \uB9D0\uC744 \uB4E3\uC9C0 \uC54A\uB294\uB2E4.\n\n\uC5D0\uB7F0\uC740 \uB0B4\uAC00
      \uC26C\uACE0 \uC788\uC73C\uB2C8 \uAD1C\uD788 \uB354 \uBD88\uC548\uD55C \uC5BC\uAD74\uC774\uB2E4.
      \uADF8\uB798\uB3C4 \uC57D\uB3C4 \uCC59\uACA8\uC8FC\uACE0 \uC2DD\uC0AC\uB3C4
      \uAC00\uC838\uB2E4\uC8FC\uBA70 \uBB35\uBB35\uD788 \uACC1\uC744 \uC9C0\uCF1C\uC92C\uB2E4.
      \uAC81\uC774 \uB9CE\uC740 \uC904\uB9CC \uC54C\uC558\uB294\uB370 \uC758\uC678\uB85C
      \uCC38 \uCC29\uD55C \uB140\uC11D\uC774\uB2E4.\n\n\uCE68\uB300\uC5D0 \uB204\uC6CC
      \uC788\uC73C\uB2C8 \uC790\uAFB8 \uC9D1 \uC0DD\uAC01\uC774 \uB09C\uB2E4. \uC5D8\uB808\uB098\uB294
      \uC798 \uC9C0\uB0B4\uACE0 \uC788\uC744\uAE4C. \uC18C\uD53C\uC544\uC640 \uB8E8\uCE74\uC2A4\uB3C4
      \uC544\uBE60\uAC00 \uC5B8\uC81C \uC624\uB0D0\uACE0 \uBB3C\uC5B4\uBCF4\uACE0
      \uC788\uACA0\uC9C0. \uC774\uBC88 \uAC10\uAE30\uB9CC \uC5BC\uB978 \uD138\uC5B4\uB0B4\uACE0
      \uB2E4\uC2DC \uC77C\uC5B4\uB098\uC57C\uACA0\uB2E4."
