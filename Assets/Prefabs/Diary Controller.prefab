--- !u!114 &3944185224547650367
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 5268386848524592414}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\uC624\uB298\uBD80\uD130 \uC2EC\uD574 \uC0DD\uBB3C \uD0D0\uC0AC \uC784\uBB34\uC5D0
    \uD22C\uC785\uB41C\uB2E4.\r\n\uCD9C\uD56D \uC804 \uBD80\uB450\uC5D0\uB294 \uC5D8\uB808\uB098\uC640
    \uC18C\uD53C\uC544, \uB8E8\uCE74\uC2A4\uAC00 \uB098\uC640 \uBC30\uC6C5\uD574
    \uC8FC\uC5C8\uB2E4. \uBC84\uB514\uB791 \uCC30\uB9AC\uB3C4 \uC2E0\uB098\uAC8C
    \uB6F0\uC5B4\uB2E4\uB2C8\uBA70 \uB098\uB97C \uBC18\uACA8\uC92C\uB2E4. \uB5A0\uB098\uB294
    \uC21C\uAC04\uAE4C\uC9C0\uB3C4 \uC544\uC774\uB4E4\uC740 \uC6C3\uACE0 \uC788\uC5C8\uC9C0\uB9CC,
    \uC5D8\uB808\uB098\uB294 \uC560\uC368 \uAC71\uC815\uC744 \uC228\uAE30\uACE0 \uC788\uB294
    \uAC8C \uB208\uC5D0 \uBCF4\uC600\uB2E4.\r\n\uC7A0\uC218\uD568\uC5D0 \uB3C4\uCC29\uD558\uC790\uB9C8\uC790
    \uBC30\uC815\uBC1B\uC740 \uBC29\uC744 \uC815\uB9AC\uD588\uB2E4. \uB77C\uCEE4
    \uBB38 \uC548\uCABD\uC5D0\uB294 \uC18C\uD53C\uC544\uAC00 \uADF8\uB824\uC900 \uAC00\uC871
    \uADF8\uB9BC\uACFC \uBC84\uB514, \uCC30\uB9AC \uC0AC\uC9C4\uC744 \uBD99\uC5EC\uB450\uC5C8\uB2E4.
    \uB77C\uCEE4\uB97C \uC5F4 \uB54C\uB9C8\uB2E4 \uAC00\uC871 \uC5BC\uAD74\uC744
    \uBCFC \uC218 \uC788\uC73C\uB2C8 \uC870\uAE08\uC740 \uBC84\uD2F8 \uD798\uC774
    \uB0A0 \uAC83 \uAC19\uB2E4.\r\n\uAC00\uC871\uC744 \uB450\uACE0 \uC2EC\uD574\uB85C
    \uB4E4\uC5B4\uAC00\uB294 \uAC74 \uC5EC\uC804\uD788 \uC27D\uC9C0 \uC54A\uB2E4.
    \uADF8\uB798\uB3C4 \uC544\uC9C1 \uC138\uC0C1\uC5D0 \uC54C\uB824\uC9C0\uC9C0 \uC54A\uC740
    \uC2EC\uD574 \uC0DD\uBB3C\uC744 \uC9C1\uC811 \uD0D0\uC0C9\uD558\uACE0 \uD3EC\uD68D\uD560
    \uC218 \uC788\uB2E4\uB294 \uC0DD\uAC01\uC5D0 \uB9C8\uC74C \uD55C\uD3B8\uC774
    \uC124\uB80C\uB2E4. \n\uC6B0\uB9AC\uAC00 \uD655\uBCF4\uD55C \uC0DD\uBB3C\uB4E4\uC740
    \uC5F0\uAD6C\uC6D0\uB4E4\uC5D0\uAC8C \uC804\uB2EC\uB418\uACE0, \uADF8 \uC5F0\uAD6C\uAC00
    \uC5B8\uC820\uAC00\uB294 \uC0C8\uB85C\uC6B4 \uCE58\uB8CC\uC81C\uB098 \uAE30\uC220
    \uAC1C\uBC1C\uB85C \uC774\uC5B4\uC838 \uB9CE\uC740 \uC0AC\uB78C\uB4E4\uC5D0\uAC8C
    \uB3C4\uC6C0\uC774 \uB420\uC9C0\uB3C4 \uBAA8\uB978\uB2E4. \uC704\uD5D8\uD55C
    \uC784\uBB34\uC9C0\uB9CC \uADF8\uB9CC\uD55C \uAC00\uCE58\uAC00 \uC788\uB2E4\uACE0
    \uBBFF\uB294\uB2E4. \uC774\uBC88 \uC784\uBB34\uB3C4 \uBAA8\uB450 \uBB34\uC0AC\uD788
    \uB9C8\uCE58\uACE0 \uAC00\uC871 \uACC1\uC73C\uB85C \uB3CC\uC544\uAC00\uC57C\uACA0\uB2E4.\r\n\uB8F8\uBA54\uC774\uD2B8\uB294
    \uB0B4 \uBD80\uD558\uC778 \uC5D0\uB7F0 \uB2E4\uC774\uC5B4\uB2E4. \uD0D1\uC2B9\uD558\uB294
    \uB0B4\uB0B4 \uAE34\uC7A5\uD55C \uD45C\uC815\uC774\uC5C8\uB2E4. \uC2EC\uD574
    \uC0DD\uBB3C\uC744 \uC2E4\uC81C\uB85C \uBCF4\uB294 \uAC74 \uCC98\uC74C\uC774\uB77C\uB294\uB370,
    \uC774\uB807\uAC8C \uAC81\uC774 \uB9CE\uC544\uC11C\uC57C \uD3EC\uD68D \uC784\uBB34\uB97C
    \uC81C\uB300\uB85C \uD560 \uC218 \uC788\uC744\uC9C0 \uBAA8\uB974\uACA0\uB2E4.
    \uADF8\uB798\uB3C4 \uACBD\uD5D8\uC744 \uC313\uB2E4 \uBCF4\uBA74 \uC870\uAE08\uC529
    \uB098\uC544\uC9C0\uACA0\uC9C0."
  m_isRightToLeft: 0
