    - target: {fileID: 7350476397579431345, guid: 719cabc9aed610a47b1adb890d6cb830,
        type: 3}
      propertyPath: m_text
      value: "\u25CF An entity that evolved a <b>Hyper-active Immune System</b> to
        survive in extreme water pressure environments.\r\n\u25CF Specific enzymes
        within its tentacle mucus induce explosive proliferation of immune cells,
        resulting in abnormally fast tissue regeneration rates.\r\n\u25CF Uncontrolled
        <b><color=#FFCC00>cellular hyper-proliferation</color></b> phenomena reported
        in some test subjects."
      objectReference: {fileID: 0}
